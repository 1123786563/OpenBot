{
  "$schema": "https://biomejs.dev/schemas/2.5.10/schema.json",
  "files": {
    "includes": [
      "**",
      "!**/dist",
      "!.",
      "!**/.zcode",
      "!**/build",
      "!**/Pods",
      "!.superpowers",
      "!app/src/lib/generated/application-config.ts",
      "!app/src/routeTree.gen.ts",
      "!desktop/src-tauri/gen",
      "!**/target",
      "!server/drizzle",
      "!plugins/.artifacts",
      "!plugins/packages/openbot/legacy-catalogue",
      "!verification",
      "!apps/openmuse",
      "!.coordination",
      "!ocr-comments.json",
      "!server/assets/craft/web-template",
      "!docs"
    ]
  },
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space"
  },
  "linter": {
    "enabled": true
  },
  "css": {
    "parser": {
      "tailwindDirectives": true
    }
  },
  "overrides": [
    {
      "includes": ["**/tests/**", "**/*.test.ts", "**/*.test.tsx"],
      "linter": {
        "rules": {
          "style": {
            "noNonNullAssertion": "off"
          },
          "suspicious": {
            "noConsole": "off"
          }
        }
      }
    },
    {
      "includes": [
        "**/tests/support/**",
        "**/support/e2e-compat.ts",
        "**/support/bun-compat.ts"
      ],
      "linter": {
        "rules": {
          "suspicious": {
            "noExplicitAny": "off",
            "noAssignInExpressions": "off"
          }
        }
      }
    },
    {
      "includes": [
        "server/src/**",
        "worker/src/**",
        "!server/src/billing/service.ts"
      ],
      "linter": {
        "rules": {
          "suspicious": {
            "noConsole": "error"
          }
        }
      }
    },
    {
      "includes": ["toolkit/src/**", "!toolkit/src/copilotkit/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["../**"],
                    "message": "The toolkit runs turns without the server. Take what it needs as a port in toolkit/ports.ts instead of importing server code."
                  },
                  {
                    "group": [
                      "./copilotkit/**",
                      "@openbot/toolkit/copilotkit",
                      "@openbot/toolkit/copilotkit/**"
                    ],
                    "message": "The toolkit core does not depend on CopilotKit. Code that needs @copilotkit/runtime lives in toolkit/src/copilotkit and imports the core, not the other way round."
                  },
                  {
                    "group": [
                      "@copilotkit/**",
                      "drizzle-orm",
                      "drizzle-orm/**",
                      "hono",
                      "hono/**"
                    ],
                    "message": "The toolkit core depends on @ag-ui, rxjs, zod and @openbot/shared only. CopilotKit-specific code goes in toolkit/src/copilotkit."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["toolkit/src/copilotkit/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["../../**"],
                    "message": "The CopilotKit adapters run without the server. Take what they need as a port or a constructor option instead of importing server code."
                  },
                  {
                    "group": [
                      "drizzle-orm",
                      "drizzle-orm/**",
                      "hono",
                      "hono/**"
                    ],
                    "message": "The CopilotKit adapters do not reach the database or the HTTP framework."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["server/src/enterprise/models/ai-sdk-v3-gateway-adapter.ts"],
      "linter": {
        "rules": {
          "suspicious": {
            "noExplicitAny": "off"
          }
        }
      }
    },
    {
      "includes": ["app/src/components/ui/**"],
      "linter": {
        "rules": {
          "a11y": {
            "useSemanticElements": "off",
            "noLabelWithoutControl": "off",
            "useKeyWithClickEvents": "off"
          }
        }
      }
    }
  ]
}
