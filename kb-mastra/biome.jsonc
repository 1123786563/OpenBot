// kb-mastra 的 biome 配置：继承根配置的结构，src/ 禁 console（对齐 server 惯例——
// 日志一律走 shared/logger 的 pino，console 输出会绕过 request_id 与结构化字段）。
// drizzle/ 是生成产物、docreader/generated/ 是 protoc 产物，都不检查。
{
  "$schema": "https://biomejs.dev/schemas/2.5.10/schema.json",
  "files": {
    "includes": [
      "**",
      "!**/node_modules",
      "!drizzle/**",
      "!src/docreader/generated/**"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space"
  },
  "linter": {
    "enabled": true
  },
  "overrides": [
    {
      "includes": ["src/**", "scripts/**"],
      "linter": {
        "rules": {
          "suspicious": {
            "noConsole": "error"
          }
        }
      }
    },
    {
      "includes": ["**/*.test.ts"],
      "linter": {
        "rules": {
          "style": {
            "noNonNullAssertion": "off"
          }
        }
      }
    }
  ]
}
