{
  "name": "@openbot/kb-mastra",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun --env-file=.env --watch src/index.ts",
    "start": "bun --no-env-file src/index.ts",
    "typecheck": "tsc --noEmit",
    "db:generate": "bun x drizzle-kit generate --config=drizzle.config.ts",
    "db:migrate": "bun --env-file=.env src/db/migrate.ts",
    "test": "bun test src/",
    "grpc:smoke": "bun --env-file=.env scripts/grpc-smoke.ts"
  },
  "dependencies": {
    "@grpc/grpc-js": "^1.14.0",
    "@grpc/proto-loader": "^0.8.1",
    "bullmq": "^5.58.0",
    "drizzle-orm": "^0.44.0",
    "hono": "^4.13.13",
    "ioredis": "^5.8.0",
    "p-limit": "^7.3.3",
    "pino": "^10.4.0",
    "postgres": "^3.4.5",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/bun": "^1.3.3",
    "@types/node": "^24.0.0",
    "drizzle-kit": "^0.31.0",
    "typescript": "^5.9.3"
  },
  "trustedDependencies": [
    "protobufjs"
  ]
}
