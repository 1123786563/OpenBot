# ── kb-mastra（WeKnora→Mastra 移植，替换 kb-service 作为 KB_SERVICE_URL 上游）──
# 端口：8082（8081 留给 Go kb-service 做契约对照与回退位）
KB_PORT=8082

# 元数据四表（knowledge_bases/knowledges/chunks/chunk_revisions）。
# 复用 OpenBot postgres 实例（data 网络内 postgres:5432），独立 database/role：
# docker/kb-mastra/init-db.sql 首次启动建库；向量不在 Postgres（见 QDRANT_URL）。
KB_DATABASE_URL=postgres://kb_mastra:kb_mastra@postgres:5432/kb_mastra

# BullMQ 队列（摄取管线重试/死信）。宿主开发用 localhost:6379。
KB_REDIS_URL=redis://localhost:6379

# 向量库：沿用主仓命名（同一部署同一变量，compose 直传）。
# 容器内 http://qdrant:6333（data 网络）；宿主开发 http://localhost:6333（loopback 已发布）。
# REST 6333 only——gRPC 6334 未发布。
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=

# upsert 批量大小（调优项；默认 40 对齐 WeKnora BatchSave，Qdrant 官方建议 100+ 可提至 128）
KB_QDRANT_BATCH=40

# 鉴权：格式 <key>:<tenant>:<role>[:kb1,kb2]，; 分隔多 key（与 kb-service 同形）。
# role ∈ read | write | admin：read=检索+读；write=+上传/删文档；admin=+建/删 KB。
KB_API_KEYS=sk-kb-dev-001:tenant-a:admin

# DocReader（WeKnora 原样复用的解析服务，gRPC :50051）
DOCREADER_ADDR=localhost:50051
# 单次解析调用超时：30min（对齐 WeKnora DOCREADER_CALL_TIMEOUT，大 PDF 解析很慢）
DOCREADER_CALL_TIMEOUT_MS=1800000

# Embedding（OpenAI 兼容 /api/embeddings 端点，如 Ollama）
OLLAMA_BASE_URL=http://localhost:11434
KB_EMBED_MODEL=
# 角色：Qdrant collection vectors.size（kb_chunks_{dim}）+ 启动自检基准。
# 换模型=换维度=必须换新 collection 全量重嵌（collection 维度不可变）。
KB_EMBED_DIMENSIONS=1024
BATCH_EMBED_SIZE=5
KB_EMBED_MAX_CONCURRENCY=32

# Rerank（可选，默认关——对齐 kb-service 契约）
KB_RERANK_ENABLED=false
KB_RERANK_URL=
KB_RERANK_MODEL=

# 存储（P1 仅 local）
STORAGE_TYPE=local
STORAGE_LOCAL_PATH=./data/kb-files
MAX_FILE_SIZE_MB=50

# 检索默认值（对齐 WeKnora tenants.retrieval_config）
KB_VECTOR_THRESHOLD=0.15
KB_KEYWORD_THRESHOLD=0.3
KB_DEFAULT_TOP_K=50
KB_RERANK_TOP_K=10
KB_RERANK_THRESHOLD=0.2
