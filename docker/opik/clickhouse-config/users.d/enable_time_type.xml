<!-- Copied verbatim from comet-ml/opik deployment/docker-compose/clickhouse_config/users.d/enable_time_type.xml
     at 2.2.100 (upstream commit c8231ef8cdabb6fc5223c8dece17959e8af461ce). -->
<clickhouse>
    <!-- ClickHouse 25.8 made the experimental Time/Time64 type opt-in. Migration
         000030_add_project_configs_table creates a Time column (dropped later by 000036),
         so fresh installs need this enabled to replay the migration chain. This is a
         profile (users.d) setting, not a server (config.d) setting. -->
    <profiles>
        <default>
            <enable_time_time64_type>1</enable_time_time64_type>
        </default>
    </profiles>
</clickhouse>
