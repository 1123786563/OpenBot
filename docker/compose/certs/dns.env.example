# DNS-01 challenge credentials for docker/compose/certs.yml (#359, reference/tls-certs.md).
#
# Copy to ./dns.env next to the repository root docker-compose.yml (it is
# git-ignored), then `chmod 600 dns.env`. Fill in EXACTLY ONE provider block and
# leave ACME_DNS beside it — the credential and the plugin travel together.
# Values are read by the sidecar's environment only; they are never logged and
# must never be committed (the pipeline checks names, not values).

# ── Cloudflare (recommended: free, and a token can be scoped to one zone) ──────────
# Create an API token with Zone:DNS:Edit on the preview zone ONLY
# (https://dash.cloudflare.com/profile/api-tokens).
#ACME_DNS=dns_cf
#CF_Token=
# Optional, when the token is not account/zone-scoped already:
#CF_Account_ID=
#CF_Zone_ID=
# Legacy global-key alternative (avoid: all-or-nothing permissions):
#CF_Email=
#CF_Key=

# ── Aliyun DNS ─────────────────────────────────────────────────────────────────────
# AccessKey pair of a RAM user granted AliyunDNSFullAccess on the preview zone's
# subdomain delegation only.
#ACME_DNS=dns_ali
#Ali_Key=
#Ali_Secret=

# ── DNSPod (Tencent) ───────────────────────────────────────────────────────────────
#ACME_DNS=dns_dp
#DP_Id=
#DP_Key=

# ── Huawei Cloud DNS ───────────────────────────────────────────────────────────────
#ACME_DNS=dns_huaweicloud
#HUAWEICLOUD_Username=
#HUAWEICLOUD_Password=

# ── deSEC (free, open source, API-first) ───────────────────────────────────────────
# Delegate the preview subdomain's NS to deSEC and scope the token to it.
#ACME_DNS=dns_desec
#DESEC_TOKEN=
