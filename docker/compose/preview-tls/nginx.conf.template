# docker/compose/preview-tls/nginx.conf.template — reference TLS terminator for the
# craft preview origin (#412, decision #403 D-2: external ingress terminates TLS; the
# OpenBot server stays plain HTTP). Rendered by start.sh (envsubst with the explicit
# variable list below) into /etc/nginx/conf.d/preview-tls.conf at container start —
# NOT by the image's own template script: that one only runs when the container
# command starts with `nginx`, and this container's command is `sh start.sh` (it
# launches the reload-watcher first). The explicit list also means nginx's own
# runtime variables ($host, $http_upgrade, …) survive untouched.
#
# Configuration (environment, see docker/compose/preview-tls.yml):
#   OPENBOT_PREVIEW_UPSTREAM       where plaintext HTTP is forwarded. Default
#                                 http://host.docker.internal:3001 — the OpenBot
#                                 server on the docker host. Point it at a compose
#                                 service name instead when the terminator runs in
#                                 the same compose network as the server.
#   OPENBOT_PREVIEW_TLS_SERVER_NAME  the wildcard the certificate covers. Default `_`
#                                 (catch-all: this is the only 443 server, so it is
#                                 also the default_server and answers every SNI name
#                                 with the wildcard certificate). Set it explicitly
#                                 (e.g. *.preview.example.com) when more 443 servers
#                                 share this terminator.
#
# The certificate comes from the ACME sidecar (docker/compose/certs.yml): the shared
# TLS directory is bind-mounted at /etc/openbot/tls (the same convention the sidecar
# and the main compose use), so cert.pem/key.pem/reload.stamp/renewal-status.json are
# the exact files the sidecar writes. This mount is READ-ONLY here — the terminator
# only consumes them.

# Websocket upgrades: craft preview sessions hold live connections (#361's session
# sockets), so the hop must be upgrade-aware, not a naive HTTP/1.0 proxy.
map $http_upgrade $connection_upgrade {
  default upgrade;
  ''      close;
}

server {
  # One wildcard certificate covers every per-session host <hash>.<preview-host>
  # (one label deep, spec craft-preview-origin D3/D7) — no per-host server blocks.
  listen 443 ssl;
  listen [::]:443 ssl;
  server_name ${OPENBOT_PREVIEW_TLS_SERVER_NAME};

  # Permission note (deliberate tradeoff): key.pem is 0600 owned by the TLS uid:gid
  # (the sidecar's OPENBOT_TLS_UID/GID). The stock nginx image's MASTER process runs
  # as root and reads the certificate pair exactly once per (re)load; the nginx-user
  # worker processes never open the key. That keeps the key unreadable to workers and
  # everything except the master, at the cost of a root master — the standard nginx
  # image posture. The non-root alternative (user: "<tls-uid>:<tls-gid>" in compose,
  # key owner matches so it stays readable, plus cap_add NET_BIND_SERVICE for 443) is
  # documented in docs/tls-certs.md; it was not made the default because it depends
  # on the deployment's TLS uid matching and on the capability being granted.
  ssl_certificate     /etc/openbot/tls/cert.pem;
  ssl_certificate_key /etc/openbot/tls/key.pem;
  ssl_protocols       TLSv1.2 TLSv1.3;
  ssl_session_cache   shared:SSL:10m;
  ssl_session_timeout 1h;
  ssl_session_tickets off;

  location / {
    proxy_pass ${OPENBOT_PREVIEW_UPSTREAM};
    proxy_http_version 1.1;
    proxy_set_header Host              $host;
    proxy_set_header Upgrade           $http_upgrade;
    proxy_set_header Connection        $connection_upgrade;
    proxy_set_header X-Real-IP         $remote_addr;
    proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
    # The server must see https: the preview cookie is SameSite=None; Secure and
    # only plants on an https origin (fix-ocr4 #9).
    proxy_set_header X-Forwarded-Proto https;
    # Long-lived preview sessions; a reload (SIGHUP) never drops them anyway, but
    # keep the idle timeouts out of the terminator's way too.
    proxy_read_timeout 3600s;
    proxy_send_timeout 3600s;
  }
}

# Loopback-only plain listener: the compose healthcheck probes this, so container
# health never depends on the certificate's validity or on the upstream answering.
server {
  listen 127.0.0.1:8080;
  server_name _;
  location = /healthz {
    access_log off;
    return 200 "ok\n";
  }
}
