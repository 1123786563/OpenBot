{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "kind",
    "revision",
    "host_id",
    "updated_at",
    "records"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "kind": {
      "enum": [
        "claims",
        "daily"
      ]
    },
    "revision": {
      "type": "integer",
      "minimum": 0
    },
    "host_id": {
      "type": "string",
      "format": "uuid"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    },
    "records": {
      "type": "array",
      "items": {
        "type": "object"
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "kind": {
            "const": "claims"
          }
        }
      },
      "then": {
        "properties": {
          "records": {
            "items": {
              "$ref": "#/$defs/claim"
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "daily"
          }
        }
      },
      "then": {
        "properties": {
          "records": {
            "items": {
              "$ref": "#/$defs/daily"
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "claim": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "resource_key",
        "mode",
        "owner_run",
        "coordinator",
        "host",
        "task",
        "attempt",
        "token",
        "generation",
        "state",
        "created_at",
        "heartbeat_at",
        "expires_at",
        "evidence"
      ],
      "properties": {
        "resource_key": {
          "type": "string"
        },
        "mode": {
          "enum": [
            "read",
            "write",
            "aggregate"
          ]
        },
        "owner_run": {
          "type": "string"
        },
        "coordinator": {
          "type": "string"
        },
        "host": {
          "type": "string",
          "format": "uuid"
        },
        "task": {
          "type": [
            "string",
            "null"
          ]
        },
        "attempt": {
          "type": "integer",
          "minimum": 0
        },
        "token": {
          "type": "string",
          "format": "uuid"
        },
        "generation": {
          "type": "integer",
          "minimum": 0
        },
        "state": {
          "enum": [
            "reserved",
            "running",
            "settling",
            "unverifiable"
          ]
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        },
        "heartbeat_at": {
          "type": "string",
          "format": "date-time"
        },
        "expires_at": {
          "type": "string",
          "format": "date-time"
        },
        "evidence": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/evidence"
          }
        }
      }
    },
    "daily": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repo_identity",
        "next_class",
        "slot_sequence",
        "consecutive_recovery",
        "issues"
      ],
      "properties": {
        "repo_identity": {
          "type": "string"
        },
        "next_class": {
          "enum": [
            "recovery",
            "new",
            "revalidate"
          ]
        },
        "slot_sequence": {
          "type": "integer",
          "minimum": 0
        },
        "consecutive_recovery": {
          "type": "integer",
          "minimum": 0
        },
        "issues": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/issue"
          }
        }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256",
        "checkpoint_id",
        "snapshot_generation",
        "attempt"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "checkpoint_id": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "snapshot_generation": {
          "type": "integer",
          "minimum": 0
        },
        "attempt": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "condition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "subject",
        "expected",
        "observed",
        "source_ref"
      ],
      "properties": {
        "kind": {
          "enum": [
            "authorization",
            "dependency",
            "environment",
            "target",
            "api_retry",
            "evidence"
          ]
        },
        "subject": {
          "type": "string",
          "minLength": 1
        },
        "expected": {
          "type": [
            "string",
            "number",
            "boolean",
            "null"
          ]
        },
        "observed": {
          "type": [
            "string",
            "number",
            "boolean",
            "null"
          ]
        },
        "source_ref": {
          "anyOf": [
            {
              "$ref": "#/$defs/evidence"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "resume": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "all"
      ],
      "properties": {
        "all": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/condition"
          }
        }
      }
    },
    "requirement_fp": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "algorithm",
        "sha256",
        "input_ref"
      ],
      "properties": {
        "algorithm": {
          "const": "requirements-v1"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "input_ref": {
          "$ref": "#/$defs/evidence"
        }
      }
    },
    "input_fp": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "algorithm",
        "sha256",
        "input_ref"
      ],
      "properties": {
        "algorithm": {
          "const": "daily-input-v1"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "input_ref": {
          "$ref": "#/$defs/evidence"
        }
      }
    },
    "child": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "issue",
        "requirements_fingerprint",
        "checkpoint",
        "validation_state"
      ],
      "properties": {
        "issue": {
          "type": "string",
          "minLength": 1
        },
        "requirements_fingerprint": {
          "anyOf": [
            {
              "$ref": "#/$defs/requirement_fp"
            },
            {
              "type": "null"
            }
          ]
        },
        "checkpoint": {
          "anyOf": [
            {
              "$ref": "#/$defs/evidence"
            },
            {
              "type": "null"
            }
          ]
        },
        "validation_state": {
          "enum": [
            "queued",
            "auditing",
            "finding_confirmed",
            "repairing",
            "revalidating",
            "verified",
            "blocked",
            "failed",
            "unproven",
            "intake_incomplete",
            "aggregate_pending"
          ]
        }
      }
    },
    "event": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "slot_sequence",
        "action",
        "result",
        "at",
        "refs"
      ],
      "properties": {
        "slot_sequence": {
          "type": "integer",
          "minimum": 0
        },
        "action": {
          "type": "string",
          "minLength": 1
        },
        "result": {
          "type": "string",
          "minLength": 1
        },
        "at": {
          "type": "string",
          "format": "date-time"
        },
        "refs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/evidence"
          }
        }
      }
    },
    "issue": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "issue",
        "class",
        "eligible_since",
        "last_slot",
        "target_sha",
        "requirements_fingerprint",
        "validation_state",
        "delivery_state",
        "label_action",
        "run",
        "workspace",
        "checkpoint",
        "review",
        "label",
        "wait_reason",
        "resume_condition",
        "input_fingerprint",
        "retry_after",
        "next_action",
        "aggregate_children",
        "history",
        "action_reason",
        "label_intent",
        "close_action",
        "close_intent"
      ],
      "properties": {
        "issue": {
          "type": "string",
          "pattern": "^[^#]+#[1-9][0-9]*$"
        },
        "class": {
          "enum": [
            "recovery",
            "new",
            "revalidate",
            null
          ]
        },
        "eligible_since": {
          "anyOf": [
            {
              "type": "string",
              "format": "date-time"
            },
            {
              "type": "null"
            }
          ]
        },
        "last_slot": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "target_sha": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^([0-9a-f]{40}|[0-9a-f]{64})$"
            },
            {
              "type": "null"
            }
          ]
        },
        "requirements_fingerprint": {
          "anyOf": [
            {
              "$ref": "#/$defs/requirement_fp"
            },
            {
              "type": "null"
            }
          ]
        },
        "validation_state": {
          "enum": [
            "queued",
            "auditing",
            "finding_confirmed",
            "repairing",
            "revalidating",
            "verified",
            "blocked",
            "failed",
            "unproven",
            "intake_incomplete",
            "aggregate_pending"
          ]
        },
        "delivery_state": {
          "enum": [
            "none",
            "repair_prepared",
            "integration_pending",
            "delivered"
          ]
        },
        "label_action": {
          "enum": [
            "none",
            "label_pending",
            "applied_valid",
            "label_correction_pending",
            "corrected"
          ]
        },
        "run": {
          "anyOf": [
            {
              "$ref": "#/$defs/evidence"
            },
            {
              "type": "null"
            }
          ]
        },
        "workspace": {
          "anyOf": [
            {
              "$ref": "#/$defs/evidence"
            },
            {
              "type": "null"
            }
          ]
        },
        "checkpoint": {
          "anyOf": [
            {
              "$ref": "#/$defs/evidence"
            },
            {
              "type": "null"
            }
          ]
        },
        "review": {
          "anyOf": [
            {
              "$ref": "#/$defs/evidence"
            },
            {
              "type": "null"
            }
          ]
        },
        "label": {
          "anyOf": [
            {
              "$ref": "#/$defs/evidence"
            },
            {
              "type": "null"
            }
          ]
        },
        "wait_reason": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "resume_condition": {
          "$ref": "#/$defs/resume"
        },
        "input_fingerprint": {
          "anyOf": [
            {
              "$ref": "#/$defs/input_fp"
            },
            {
              "type": "null"
            }
          ]
        },
        "retry_after": {
          "anyOf": [
            {
              "type": "string",
              "format": "date-time"
            },
            {
              "type": "null"
            }
          ]
        },
        "next_action": {
          "type": "string",
          "minLength": 1
        },
        "aggregate_children": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/child"
          }
        },
        "history": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/event"
          }
        },
        "action_reason": {
          "type": [
            "string",
            "null"
          ]
        },
        "label_intent": {
          "anyOf": [
            {
              "$ref": "#/$defs/evidence"
            },
            {
              "type": "null"
            }
          ]
        },
        "close_action": {
          "enum": [
            "none",
            "close_pending",
            "applied_valid",
            "close_correction_pending",
            "corrected"
          ]
        },
        "close_intent": {
          "anyOf": [
            {
              "$ref": "#/$defs/evidence"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    }
  },
  "$id": "https://openbot.invalid/agent-rules/coordination-v1.schema.json",
  "title": "OpenBot coordination v1 (local schema; no remote resolution required)"
}
