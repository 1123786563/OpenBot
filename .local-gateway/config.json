{
  "$schema": "https://www.getbifrost.ai/schema",
  "setup_token": "openbot-local-gateway-setup",
  "server": {
    "port": 9900,
    "host": "127.0.0.1"
  },
  "config_store": {
    "enabled": true,
    "type": "sqlite",
    "config": {
      "path": "./data/gateway.db"
    }
  },
  "logs_store": {
    "enabled": false
  },
  "client": {
    "drop_excess_requests": false,
    "initial_pool_size": 100,
    "allowed_origins": ["*"],
    "enable_logging": true,
    "enforce_auth_on_inference": false,
    "max_request_body_size_mb": 100
  },
  "plugins": [
    {
      "enabled": true,
      "name": "governance",
      "config": {
        "openbot_credit_admission": {
          "enabled": true
        }
      }
    }
  ]
}
