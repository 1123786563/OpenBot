# Set this to the Windows VM's bridged LAN IP, reachable from Docker.
WINDOWS_RDP_HOST=192.168.1.50
WINDOWS_RDP_PORT=3389
WINDOWS_RDP_USERNAME=demo
WINDOWS_RDP_PASSWORD=replace-with-a-windows-password
WINDOWS_RDP_DOMAIN=

# Local login for the Guacamole web page.
GUACAMOLE_USERNAME=demo
GUACAMOLE_PASSWORD=change-this-demo-password
