--- /dev/null	2026-10-21 09:34:37
+++ app/tests/skills-draft-lifecycle.test.tsx	2026-10-21 09:34:06
@@ -0,0 +1,166 @@
+import "./preload";
+import { GlobalRegistrator } from "@happy-dom/global-registrator";
+import { QueryClient, QueryClientProvider } from "@tanstack/react-query";
+import {
+  createMemoryHistory,
+  createRootRoute,
+  createRoute,
+  createRouter,
+  Outlet,
+  RouterProvider,
+} from "@tanstack/react-router";
+import { act, cleanup, render, waitFor } from "@testing-library/react";
+import userEvent from "@testing-library/user-event";
+import { type AuthenticatedUser, authKeys } from "@/lib/auth/queries";
+import { type PluginsPage, pluginKeys } from "@/lib/plugins/queries";
+import { Route as SkillsRoute } from "@/routes/_authed/_app/skills";
+import {
+  afterAll,
+  afterEach,
+  beforeAll,
+  expect,
+  test,
+} from "../../tests/support/e2e-compat";
+
+class Observer implements ResizeObserver {
+  static targets = new Map<Element, Observer>();
+  constructor(private readonly callback: ResizeObserverCallback) {}
+  observe(target: Element) {
+    Observer.targets.set(target, this);
+  }
+  unobserve(target: Element) {
+    Observer.targets.delete(target);
+  }
+  disconnect() {
+    for (const [target, observer] of Observer.targets)
+      if (observer === this) Observer.targets.delete(target);
+  }
+  resize(target: Element, width: number) {
+    this.callback(
+      [
+        {
+          target,
+          contentRect: new DOMRect(0, 0, width, 640),
+          borderBoxSize: [],
+          contentBoxSize: [],
+          devicePixelContentBoxSize: [],
+        },
+      ],
+      this,
+    );
+  }
+}
+
+let originalObserver: typeof ResizeObserver;
+beforeAll(() => {
+  GlobalRegistrator.register();
+  originalObserver = globalThis.ResizeObserver;
+  globalThis.ResizeObserver = Observer;
+});
+afterEach(() => {
+  cleanup();
+  Observer.targets.clear();
+});
+afterAll(() => {
+  globalThis.ResizeObserver = originalObserver;
+  GlobalRegistrator.unregister();
+});
+
+function captureRouteState(route: object): Record<string, unknown> {
+  return { ...route, options: { ...(route as { options: object }).options } };
+}
+function restoreRouteState(route: object, snapshot: Record<string, unknown>) {
+  for (const key of Object.keys(route))
+    if (!(key in snapshot)) delete (route as Record<string, unknown>)[key];
+  Object.assign(route, snapshot);
+}
+const pristineSkillsRouteState = captureRouteState(SkillsRoute);
+
+async function resize(container: HTMLElement, width: number) {
+  const target = container.firstElementChild;
+  if (!target) throw new Error("Panel root missing");
+  await act(async () => {
+    Observer.targets.get(target)?.resize(target, width);
+  });
+}
+
+test("new skill title and dirty state survive the DetailPanel breakpoint", async () => {
+  const routeSnapshot = captureRouteState(pristineSkillsRouteState);
+  const client = new QueryClient({
+    defaultOptions: { queries: { retry: false } },
+  });
+  const page: PluginsPage = {
+    catalogue: [],
+    servers: [],
+    skills: [],
+    botsMayCallBack: true,
+    redirectUri: null,
+    composioConfigured: false,
+    openConnectorConfigured: false,
+  };
+  const user: AuthenticatedUser = {
+    id: "user-1",
+    email: "person@example.com",
+    role: "user",
+    onboarding: null,
+  };
+  client.setQueryData(pluginKeys.page(), page);
+  client.setQueryData(authKeys.currentUser(), user);
+
+  const rootRoute = createRootRoute({ component: Outlet });
+  const authedRoute = createRoute({
+    id: "/_authed",
+    getParentRoute: () => rootRoute,
+    component: Outlet,
+  });
+  const appRoute = createRoute({
+    id: "/_app",
+    getParentRoute: () => authedRoute,
+    component: Outlet,
+  });
+  const skills = (
+    SkillsRoute as unknown as { update: (options: unknown) => unknown }
+  ).update({
+    path: "/skills",
+    getParentRoute: () => appRoute,
+  });
+  const router = createRouter({
+    routeTree: rootRoute.addChildren([
+      authedRoute.addChildren([appRoute.addChildren([skills as never])]),
+    ]),
+    history: createMemoryHistory({ initialEntries: ["/skills?new=true"] }),
+  });
+  const view = render(
+    <QueryClientProvider client={client}>
+      <RouterProvider router={router as never} />
+    </QueryClientProvider>,
+  );
+  try {
+    const title = await view.findByPlaceholderText("My standup skill");
+    const user = userEvent.setup({ document: view.baseElement.ownerDocument });
+    await user.type(title, "A retained skill");
+    const form = title.closest("form");
+    expect(form?.getAttribute("data-dirty")).toBe("true");
+    expect((title as HTMLInputElement).value).toBe("A retained skill");
+
+    await resize(view.container, 880);
+    await resize(view.container, 879);
+    expect(await view.findByRole("dialog", { name: /details/i })).toBeTruthy();
+    await resize(view.container, 880);
+    await waitFor(() =>
+      expect(view.queryByRole("dialog", { name: /details/i })).toBeNull(),
+    );
+
+    const retainedTitle = view.getByPlaceholderText(
+      "My standup skill",
+    ) as HTMLInputElement;
+    expect(retainedTitle.value).toBe("A retained skill");
+    expect(retainedTitle.closest("form")?.getAttribute("data-dirty")).toBe(
+      "true",
+    );
+    expect(router.state.location.pathname).toBe("/skills");
+    expect(router.state.location.search).toEqual({ new: true });
+  } finally {
+    restoreRouteState(SkillsRoute, routeSnapshot);
+  }
+});
