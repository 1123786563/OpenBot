#!/usr/bin/env python3
"""Publish the multitenancy tickets to GitHub in dependency order and link them as sub-issues of the Spec.

Resumable: published.json records ticket id -> issue number. Run again to continue after an interruption.
"""
import json, re, subprocess, sys, time
from pathlib import Path

HERE = Path(__file__).resolve().parent
REPO = "1123786563/OpenBot"
PARENT = 6
LABEL = "ready-for-agent"
PUB = HERE / "published.json"

manifest = json.loads((HERE / "manifest.json").read_text())
tickets = manifest["tickets"]
titles = {t["id"]: t["title"] for t in tickets}
groups = {t["id"]: t["group"].split()[0] for t in tickets}
published = json.loads(PUB.read_text()) if PUB.exists() else {}


def sh(args, retries=4):
    for attempt in range(retries):
        r = subprocess.run(args, capture_output=True, text=True)
        if r.returncode == 0:
            return r.stdout.strip()
        err = (r.stderr or r.stdout).strip()
        if "rate limit" in err.lower() or "secondary" in err.lower() or "timeout" in err.lower():
            wait = 20 * (attempt + 1)
            print(f"  retry in {wait}s: {err[:160]}", flush=True)
            time.sleep(wait)
            continue
        raise SystemExit(f"command failed: {' '.join(args[:6])}\n{err[:800]}")
    raise SystemExit(f"gave up after {retries} attempts: {' '.join(args[:6])}")


def render(t):
    body = (HERE / "tickets" / f"{t['id']}-{t['slug']}.md").read_text()

    def fix(mo):
        dep = mo.group(1)
        n = published.get(dep)
        return (f"- [#{n}](https://github.com/{REPO}/issues/{n}) {titles[dep]}（{dep}）"
                if n else f"- {dep} {titles[dep]} — 尚未发布")
    body = re.sub(r"^- (MT\d{3}).*$", fix, body, flags=re.M)
    header = (f"> 拆解编号 **{t['id']}** · 分组 **{t['group']}** · 覆盖验收 **{', '.join(t['acceptance'])}**"
              f" · 父 Spec #{PARENT}\n"
              f"> 粒度：单个 code agent 上下文内可完成；本 Ticket 失败时另一个 agent 可依本正文直接接手。\n\n")
    return header + body


created = 0
for t in tickets:
    if t["id"] in published:
        continue
    title = f"[{groups[t['id']]}] {t['id']} {t['title']}"
    if len(title) > 140:
        title = title[:137] + "..."
    tmp = HERE / ".tmp-body.md"
    tmp.write_text(render(t))
    url = sh(["gh", "issue", "create", "--repo", REPO, "--title", title,
              "--body-file", str(tmp), "--label", LABEL])
    number = int(url.rstrip("/").split("/")[-1])
    published[t["id"]] = number
    PUB.write_text(json.dumps(published, ensure_ascii=False, indent=1) + "\n")
    created += 1
    print(f"[{created}] {t['id']} -> #{number} {title[:70]}", flush=True)
    tmp.unlink(missing_ok=True)
    time.sleep(0.4)

print(f"\ncreated/updated: {created}; total published: {len(published)}")

# --- link every ticket as a native sub-issue of the Spec --------------------
node_of = {}
for page in (1, 2, 3, 4):
    out = sh(["gh", "api", f"repos/{REPO}/issues?state=open&per_page=100&page={page}",
              "--jq", ".[] | \"\\(.number) \\(.node_id)\""])
    if not out:
        break
    for line in out.splitlines():
        n, node = line.split()
        node_of[int(n)] = node
print(f"fetched node ids: {len(node_of)}")

parent_node = node_of.get(PARENT)
if not parent_node:
    raise SystemExit(f"parent #{PARENT} node id not found")

linked = 0
for t in tickets:
    n = published.get(t["id"])
    node = node_of.get(n)
    if not n or not node:
        print(f"skip {t['id']}: missing number/node")
        continue
    r = subprocess.run(["gh", "api", f"repos/{REPO}/issues/{PARENT}/sub_issues",
                        "-f", f"sub_issue_id={node}"], capture_output=True, text=True)
    if r.returncode == 0:
        linked += 1
    else:
        msg = (r.stderr or r.stdout).strip()[:200]
        if "already" in msg.lower():
            linked += 1
        else:
            print(f"link failed {t['id']} #{n}: {msg}")
    time.sleep(0.25)
print(f"sub-issue links attempted ok: {linked}/{len(tickets)}")
