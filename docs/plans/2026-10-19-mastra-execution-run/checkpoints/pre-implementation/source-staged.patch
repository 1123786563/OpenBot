@@ -0,0 +1,24 @@
+#!/usr/bin/env bash
+# R1 rescan: 树结构重扫（同四根），diff 出新增节点；票详情仅增量拉取。只读。
+set -euo pipefail
+REPO=1123786563/OpenBot
+DIR="$(cd "$(dirname "$0")" && pwd)"
+: > "$DIR/contains.tsv"
+frontier="6 5 358 376"
+seen="6 5 358 376"
+while [ -n "$frontier" ]; do
+  next=""
+  for n in $frontier; do
+    kids=$(gh api --paginate "repos/$REPO/issues/$n/sub_issues" --jq '.[].number' | sort -n | tr '\n' ' ')
+    for k in $kids; do
+      echo -e "$n\t$k" >> "$DIR/contains.tsv"
+      if ! grep -qw "$k" <<< "$seen"; then
+        seen="$seen $k"
+        next="$next $k"
+      fi
+    done
+  done
+  frontier=$(echo $next)
+done
+echo $seen | tr ' ' '\n' | sed '/^$/d' | sort -n > "$DIR/nodes.txt"
+echo "nodes: $(wc -l < "$DIR/nodes.txt")"
