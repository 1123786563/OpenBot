        "\u4ec5\u5f53\u524d\u6709\u7ba1\u7406\u6743\u7684\u521b\u5efa\u8005\u53ca\u8303\u56f4\u5185\u7ba1\u7406\u5458\u53ef\u67e5\u770b\uff1bpublic \u804a\u5929\u6743\u3001\u4f2a\u9020\u5f52\u5c5e\u3001\u731c\u6d4b ID \u6216\u8de8 scope \u6e38\u6807\u4e0d\u80fd\u6269\u5927\u8bbf\u95ee\u3002",
        "\u79fb\u4ea4\u6216\u64a4\u6743\u540e\u5386\u53f2\u8be6\u60c5\u3001\u5206\u9875\u548c\u7f13\u5b58\u4e0d\u53ef\u7ee7\u7eed\u8bfb\u53d6\uff1b\u4e24\u4e2a\u6d4b\u8bd5 scope \u7684\u76f8\u540c\u8d44\u6e90 ID \u9694\u79bb\uff0c\u672a\u77e5\u4f01\u4e1a scope \u62d2\u7edd\u3002",
        "\u5bfc\u51fa\u524d\u6cbb\u7406\u8986\u76d6\u6b63\u6587\u3001metadata\u3001\u5f02\u5e38\u53ca URL\uff1b\u65e0\u6cd5\u53ef\u9760\u5904\u7406\u7684\u81ea\u7531\u6587\u672c\u4ec5\u6307\u6807\uff0c\u539f\u6587\u9644\u4ef6\u3001\u80fd\u529b\u51ed\u8bc1\u53ca\u8d26\u53f7\u6807\u8bc6\u4e0d\u53ef\u8bfb\u53d6\u3002",
