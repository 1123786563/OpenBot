      "delivers": "\u521b\u5efa\u8005\u9009\u62e9\u51bb\u7ed3\u6570\u636e\u96c6\u53ca Bot \u914d\u7f6e\u63d0\u4ea4\u72ec\u7acb\u8bc4\u6d4b\uff0c\u67e5\u770b\u9010\u6837\u672c\u89c4\u5219\u8bc4\u5206\u3001\u8fd0\u884c\u7ed3\u679c\u3001\u5931\u8d25\u548c\u53d6\u6d88\uff0c\u5e76\u5173\u8054\u5b89\u5168\u6267\u884c\u8bb0\u5f55\u3002",
