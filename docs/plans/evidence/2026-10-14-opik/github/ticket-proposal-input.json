      "delivers": "\u521b\u5efa\u8005\u4ece\u53ef\u7528\u8131\u654f\u8fd0\u884c\u6216\u5ba1\u67e5\u540e\u7684\u5408\u6210\u6848\u4f8b\u5efa\u7acb\u8bc4\u6d4b\u96c6\uff0c\u5728\u9875\u9762\u68c0\u67e5\u8f93\u5165\u3001\u53c2\u8003\u7ed3\u679c\u4e0e\u5de5\u5177 fixture \u540e\u4fdd\u5b58\u5e76\u67e5\u770b\u51bb\u7ed3\u7248\u672c\u3002",
      "acceptance": [
