+        if (list.length < EVIDENCE_PER_ITEM) {
+          list.push({
+            conclusion: row.conclusion,
+            source: row.source,
+            summary: row.summary,
+            usageInput: row.usageInput,
+            usageOutput: row.usageOutput,
