export async function scopeOf(
  fixture: PluginInstallFixture,
  identity: FixtureIdentity,
  teamKey: TeamKey,
): Promise<PlatformScope> {
  return fixture.base.scopeFor(
    identity,
    fixture.base.teamOf(identity, teamKey),
  );
}
