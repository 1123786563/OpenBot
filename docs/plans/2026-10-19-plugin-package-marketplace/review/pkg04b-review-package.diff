    generation: 1,
    status: "enabled",
    readiness: "ready",
    blockers: [],
    allowedActions: [],
    resources: [
      ...(withTemplates
        ? [
            {
              id: RESOURCE_ID,
              kind: "expertTemplate" as const,
              available: true,
            },
          ]
        : []),
      { id: "notes-writer", kind: "skill", available: true },
      { id: "tracker", kind: "managedConnector", available: false },
