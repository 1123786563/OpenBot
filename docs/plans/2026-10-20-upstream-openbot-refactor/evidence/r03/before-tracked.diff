+      await withMockedVendor(
+        "https://mcp.firecrawl.dev",
+        ["firecrawl_crawl", "firecrawl_search"],
+        async (mock) => {
+          // `firecrawl_crawl` launches a crawl on the vendor: a write by the entry's read list, even
+          // though no reviewed write list named it.
