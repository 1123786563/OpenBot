  assertDirectoryDatabase,
  assertOperatorDatabase,
  type DirectoryDatabase,
  type OperatorDatabase,
} from "./connections";

// ---------------------------------------------------------------------------
// 审计：本模块封闭事件集合（撤权审计类型在 revocation.ts，跨面审计在
// admin-separation.ts——同一张表、同一条 RLS INSERT 策略，各自封闭集合）
