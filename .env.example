DATABASE_URL=postgres://openbot:openbot@localhost:5432/openbot
# Credential vault encryption key. The example value is public and only suitable for local
# development. Production refuses to start with this key.
#   openssl rand -base64 32
KEY_ENCRYPTION_KEY=AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=
# How many days of audit trail to keep. Unset keeps everything, which is the safe default and the
# one to leave alone until somebody has decided otherwise: the trail is append-only and nothing else
# can remove a row, so this is the only way it ever shrinks.
# AUDIT_RETENTION_DAYS=365
# Two names for one number, and they must agree when both are set.
#
# The server accepts either PORT or SERVER_PORT (server/src/config.ts), preferring PORT when both
# are present and refusing to start if they disagree, so a single edit is enough. An empty value
# is an unset one, so `PORT=` with SERVER_PORT set moves the server too. scripts/start.sh
# and the app's Vite proxy read SERVER_PORT/APP_PORT, and docs/configuration.md documents
# SERVER_PORT as the setting. Only PORT shipped here historically, so moving the server by
# editing one line left the script still looking at 3001: it found whatever else was there,
# accepted the first 200 as proof, and failed several stages later parsing that stranger's
# HTML as JSON. Setting both to the same value remains valid.
PORT=3001
SERVER_PORT=3001
TENANT_PACKAGE_DIR=../examples/fintech
# Let a Bot answer with an interface it wrote itself: markup, styles and a script it generates for
# that one answer, streamed into the transcript and rendered in a sandboxed iframe with no
# same-origin access to this app. On by default; set this to `false` or `0` to opt out.
#
# This is not the component catalogue. A component is something this deployment holds and an
# administrator grants per Bot; this has nothing to grant, because the Bot writes it on the spot and
# it is gone when the conversation moves on. It is a deployment switch rather than a per-Bot grant
# because the SDK offers no seam for one — see DeploymentConfig.generativeUi in server/src/config.ts.
#
# What the interface can reach is what the sandbox hands it, and this deployment hands it nothing: no
# session, no same-origin access, and no route into your data. It can load libraries from a CDN, so a
# deployment that must not reach the public internet from a browser tab should set this to false.
# OPENBOT_GENERATIVE_UI=false
# The signed-in app shows a bar offering CopilotKit's help self-hosting OpenBot, until each person
# closes it. A deployment on a paid Intelligence plan never shows it. A fork running OpenBot for its
# own organization can turn it off for everybody.
# OPENBOT_SELF_HOST_BANNER=false
# What this deployment calls itself, when more than one shares an Intelligence project. A copy of a
# deployment made for development uses the same project key, and threads are listed per Bot with
# nothing to say which deployment a conversation came from. The name goes into every thread id this
# deployment mints, so its own conversations stay identifiable. Unset, the tenant package's id is
# used, which tells two packages apart but not two copies of one.
# DEPLOYMENT_ID=
# Sign-in. The line below runs the deployment as one administrator with no sign-in at all, which is
# how you reach the product without registering an OAuth client first. Delete it and configure a
# provider before anybody else can reach this: while it is set, every visitor is an administrator.
# With no provider and this line gone, the deployment refuses to start rather than guessing.
OPENBOT_SINGLE_USER=true
# Optional desktop employee sign-in authority: an OpenBot deployment configured with a provider
# below. Separate from Intelligence URLs/project credentials; secrets stay on the authority.
# When set, verified employee identity replaces the standalone actor even if SINGLE_USER is true.
# OPENBOT_ORGANIZATION_AUTH_URL=https://openbot.company.example
#
# Configure ANY ONE of the three providers to turn sign-in on. Configure several and the sign-in
# screen offers several, which is the normal shape for a company mid-migration.
#
# These four are needed whichever provider you pick:
#   BETTER_AUTH_URL is where OAuth callbacks come back to, which is the API on port 3001.
#   BETTER_AUTH_SECRET signs session cookies. At least 32 characters: openssl rand -base64 32
#   TRUSTED_ORIGINS is where the app is served from, which is port 3010 locally.
#   INITIAL_ADMIN_EMAILS names who is an administrator. Required, because nothing else grants the
#   role and no screen can promote somebody later. Re-read on every sign-in, so editing it works.
# BETTER_AUTH_URL=http://localhost:3001
# BETTER_AUTH_SECRET=
# INITIAL_ADMIN_EMAILS=admin@example.com
#
# Google. Redirect URI: http://localhost:3001/api/auth/callback/google
# GOOGLE_OAUTH_CLIENT_ID=
# GOOGLE_OAUTH_CLIENT_SECRET=
#
# Microsoft (Entra ID). Redirect URI: http://localhost:3001/api/auth/callback/microsoft
# MICROSOFT_OAUTH_TENANT_ID defaults to `common`, which admits personal Microsoft accounts as well
# as work ones. Put your directory GUID here if you mean only your own company.
# MICROSOFT_OAUTH_CLIENT_ID=
# MICROSOFT_OAUTH_CLIENT_SECRET=
# MICROSOFT_OAUTH_TENANT_ID=common
#
# Okta. Redirect URI: http://localhost:3001/api/auth/callback/okta
# The issuer is what makes it your Okta rather than Okta in general.
# OKTA_OAUTH_CLIENT_ID=
# OKTA_OAUTH_CLIENT_SECRET=
# OKTA_OAUTH_ISSUER=https://example.okta.com/oauth2/default
#
# Casdoor. Redirect URI: http://localhost:3001/api/auth/callback/casdoor
# The issuer is your Casdoor origin, whose .well-known/openid-configuration names the endpoints.
# In Casdoor, the redirect URI goes on the Application, and the client id/secret are the
# Application's Client ID / Client Secret. The compose stack runs one at localhost:8000, backed
# by the shared postgres in its own `casdoor` schema; see casdoor/ in the repo.
# CASDOOR_OAUTH_CLIENT_ID=
# CASDOOR_OAUTH_CLIENT_SECRET=
# CASDOOR_OAUTH_ISSUER=http://localhost:8000

# Email domains admitted at sign-in, comma separated. Empty admits everybody, which is what the
# providers above already do on their own: the Entra tenant is `common` unless changed, which is any
# Microsoft account including personal ones, and Okta has no equivalent. Google has one, `hd`, which
# is stronger than this because Google verifies Workspace domain ownership; narrow it there as well
# rather than instead.
#
# A filter, not a boundary: it is checked against the address the provider returns, and OpenBot does
# not require a verified one. The server refuses this combined with MICROSOFT_OAUTH_TENANT_ID=common,
# where that address is written by the tenant signing in.
#
# Matched exactly, no wildcards, so name every domain you use. `example.com` admits neither
# `sub.example.com` nor `evil-example.com`.
# SIGNIN_ALLOWED_EMAIL_DOMAINS=example.com,example.co.uk

# Where this deployment is reached from outside. Only needed for connectors that a person connects
# their own account to, such as Google Drive, and for linking GitHub accounts: it builds the
# redirect URI the vendor sends them back to, which has to match what an administrator registered
# character for character. Defaults to BETTER_AUTH_URL, so most deployments never set it; set it
# where the API is behind a different public address than the one sign-in uses. Without either, the
# Plugins page says so and nobody can connect an account, and GITHUB_APP_CLIENT_ID stops the server
# at start-up.
# OPENBOT_PUBLIC_URL=https://openbot.example.com

# Where the browser app is served from. The OAuth callback lands on the API and has to send the
# person back to a page, and locally those are two different ports: the app is 3010 and the API is
# 3001. Defaults to the first TRUSTED_ORIGINS entry, then to OPENBOT_PUBLIC_URL, which is right for a
# deployment serving both from one origin.
# OPENBOT_APP_URL=http://localhost:3010
TRUSTED_ORIGINS=http://localhost:3010

# CopilotKit Intelligence. Required: the server refuses to start without the URL, the gateway URL
# and the key below, because Intelligence owns durable threads and memory and a deployment without it
# forgets every conversation. There is no degraded mode.
#
# These two point at the managed service; leave them unless you run Intelligence yourself. To try
# it on one Mac, the CLI's local evaluation writes both for you (see "Intelligence on your own
# machine" in README.md): https://docs.copilotkit.ai/intelligence/self-hosting-local
# Running it in production on your own infrastructure is an Enterprise Intelligence Platform
# feature deployed by Helm chart: https://docs.showcase.copilotkit.ai/premium/self-hosting
INTELLIGENCE_API_URL=https://api.intelligence.copilotkit.ai
INTELLIGENCE_GATEWAY_WS_URL=wss://realtime.intelligence.copilotkit.ai
#
# Get the key from the CopilotKit CLI:
#
#   npx --yes copilotkit@latest login           # browser sign-in
#   npx --yes copilotkit@latest project select  # writes the cpk-... key to .env as CPK_INTELLIGENCE_API_KEY
#   bun scripts/setup-learning.ts               # copies it here, as INTELLIGENCE_API_KEY
#
# The server reads only INTELLIGENCE_API_KEY, so a key left as CPK_INTELLIGENCE_API_KEY is not seen.
#
# The runtime key is also under "API Keys" in your project at https://intelligence.copilotkit.ai
INTELLIGENCE_API_KEY=

# Optional, and blank on purpose. Managed Intelligence derives entitlement from the project key
# above and issues no licence token. A self-hosted Intelligence with its own licence sets this and
# it is forwarded to the runtime; startup does not require it.
COPILOTKIT_LICENSE_TOKEN=

# Learning defaults on. Fresh managed setup: login, project select, then bun scripts/setup-learning.ts.
# The helper creates/reuses openbot and writes the verified key and container; custom targets stay.
# Fresh self-hosted setup: set its API URL, install Chrome/Edge, then run the same helper to sign in.
# With nothing saved in Admin and no container below, the server assigns the key's project's openbot
# container by itself once it exists. The key cannot create it: run the helper (it keeps an existing
# key) or create it in Intelligence. scripts/start.sh runs that check on every start, non-interactively.
# Admin → Automatic Learning can enable/disable, override per Bot, and save settings in the DB.
# Saved settings take precedence, including off. Without an assigned container, collection and
# delivery stay inactive; OpenBot still starts and chats.
# false or 0 stops the automatic openbot assignment. A container named below also stops it.
# OPENBOT_LEARNING_AUTO_ASSIGN=false
# The runtime key cannot create the openbot container; bun run start does it with your CopilotKit
# CLI login. On a CopilotKit local evaluation install a service token can, together with its project:
# INTELLIGENCE_SERVICE_TOKEN=
# INTELLIGENCE_PROJECT_ID=
# Memory sources and background research switch on for each person and Bot they talk to, and never
# back on once the person turns one off. false or 0 stops new defaults for the whole deployment.
# OPENBOT_MEMORY_SOURCE_DEFAULTS=false
# OPENBOT_PROACTIVE_DEFAULTS=false
# Project credentials remain server-side; review and publish skills in the Intelligence UI.
# CPK_INTELLIGENCE_LEARNING_CONTAINER_ID=support-learning
# Optional opaque published revision ID; omit to follow latest.
# CPK_INTELLIGENCE_SKILLS_REVISION=exact-revision-id
# See docs/automatic-learning.md for managed/self-hosted setup and permissions.

# How long a Bot's stream may say nothing before this deployment gives up on the turn, in
# milliseconds. A Bot is any AG-UI endpoint, which means it will be redeployed mid-answer, its own
# upstream will time out, and it will sometimes accept a connection and then write nothing at all.
# Without this the channel stays busy, the composer stays locked, and the only way out is a reload.
#
# Silence, not duration. A turn may legitimately run for an hour while events keep arriving; what is
# measured here is the gap between them. Nothing about how long a Bot is allowed to work changes.
#
# A minute, because this deadline is in a race it has to win. Every Bot in this repository serves on
# Bun with `idleTimeout: 120`, and Bun tears a wedged streaming response down at roughly a second
# past that. A watchdog set to the same two minutes lands within a second of the socket dying, and
# whichever gets there first decides what the person sees: this deployment's sentence naming the Bot
# and saying the turn was ended, or "The socket connection was closed unexpectedly" and no audit row
# at all. Half the Bot's own idle timeout is far enough clear that the answer is always the first.
#
# A minute is still far longer than any real silence inside a run. The longest legitimate one is the
# wait for a model's first token, which is seconds. Browser tool calls do not need allowing for:
# they run between turns, not during one, because the run ends before the browser executes the tool
# and a second run carries the result back.
#
# 0, or leaving this unset, switches the watchdog off. Nothing is watched and no turn is ever ended.
AGENT_STALL_TIMEOUT_MS=60000

# Model key. Required by the proof-of-concept Bot, which speaks OpenAI's API directly, and by the
# framework Bot unless you point it at another provider below.
OPENAI_API_KEY=

# Where that key is spent. Unset, it is OpenAI. Set, it is any endpoint speaking the same
# `/v1/chat/completions` API: a gateway in front of several providers, a proxy, or a model on
# hardware you control. The API server reads it for the built-in agents and both shipped Bots read
# it too, so one line moves the whole deployment rather than one Bot.
#
# Model names travel verbatim, so use whatever the endpoint publishes. An endpoint that namespaces
# its catalogue wants both halves of the name, in `BOT_MODEL` and in the tenant package's
# `default_model` alike:
#
#   OPENAI_BASE_URL=https://gateway.internal/v1
#   OPENAI_API_KEY=...
#   BOT_MODEL=openai/gpt-5.5
#
# OPENAI_BASE_URL=

# Optional dictation, independent of every agent/chat provider. Set provider, base URL,
# and model together. The endpoint must implement POST /audio/transcriptions under this
# base URL (include /v1 if needed). No chat endpoint or API key is inherited.
# TRANSCRIPTION_PROVIDER=openai-compatible
# TRANSCRIPTION_BASE_URL=https://api.openai.com/v1
# TRANSCRIPTION_MODEL=gpt-transcribe
# TRANSCRIPTION_API_KEY=
# The key may be omitted for an explicitly configured local service without authentication.

# Optional live voice calls. Independent from dictation and each agent's chat provider.
# Choose openai-realtime (WebRTC) or xai-realtime (Grok Voice over WebSocket).
# VOICE_PROVIDER=openai-realtime
# VOICE_MODEL=gpt-realtime
# VOICE_NAME=marin
# VOICE_API_KEY=$OPENAI_API_KEY
# Grok alternative: VOICE_PROVIDER=xai-realtime, VOICE_MODEL=grok-voice-latest,
# VOICE_NAME=ara, VOICE_API_KEY=$XAI_API_KEY (define XAI_API_KEY separately).

# Optional. Leave empty unless containers need a different route to the same compatible endpoint,
# such as a locally hosted model whose host URL is localhost but whose Compose-network URL is a
# service name. Empty means containers use OPENAI_BASE_URL too.
# OPENAI_CONTAINER_BASE_URL=

# The same for the other two providers, under the names the API server already reads. They are
# different APIs rather than different URLs for this one, so each has its own.
# ANTHROPIC_BASE_URL=
# GOOGLE_GENERATIVE_AI_BASE_URL=

# Framework Bot provider: openai, anthropic or google. It reads that provider's own
# key and refuses to start without it, so a deployment on Anthropic never needs an OpenAI key for it.
# The proof-of-concept Bot is OpenAI only by construction: it speaks that API directly.
# BOT_PROVIDER=openai
# ANTHROPIC_API_KEY=
# GOOGLE_API_KEY=

# A model sign-in in place of a key: the Anthropic token from `claude setup-token`, and the file a
# signed-in ChatGPT plan writes. The desktop app sets both when a provider is connected that way; a
# box you configure yourself sets them here. The API server reads them for built-in agents, and
# compose passes them to the picked harness. See docs/configuration.md.
# CLAUDE_CODE_OAUTH_TOKEN=
# CHATGPT_AUTH_FILE=

# Which model the framework Bot uses. Defaults per provider: gpt-5.5, claude-sonnet-4-5,
# gemini-2.5-flash. A 5.6 tier works here: set one and the Responses API is switched on
# automatically. It used to answer nothing at all on those models — RUN_STARTED, RUN_FINISHED, no
# text — because that API streams content blocks rather than a string and the run read only the
# string. The default is left at 5.5 so the two shipped Bots stay comparable out of the box.
# BOT_MODEL=gpt-5.5

# OpenAI only, and rarely needed: the framework Bot turns the Responses API on by itself for models
# that require it. Set it when you are using a model this build has not heard of that needs it too.
# BOT_RESPONSES_API=false

# How hard the framework Bot thinks, on models that reason. OpenAI's setting, and one the Responses
# API carries, so it needs a model running on that API — a 5.6 tier does by itself, anything else
# wants BOT_RESPONSES_API=true. Unset, the model keeps its provider's own default.
#
# One of: none, minimal, low, medium, high, xhigh, max. Anything else and the Bot refuses to start
# and says so, rather than starting with a setting that quietly went nowhere.
# BOT_REASONING_EFFORT=

# The Bot computer. Absent means the feature is off and its routes are not mounted.
AGENT_COMPUTER_URL=http://localhost:4100
# Secret every computer requires from its caller. `agent-computer` drives a browser holding real
# logins, while policy, audit and sign-in live in the API server. The computer refuses to start
# without this value and refuses every request that does not present it. Use a long random value;
# `scripts/start.sh` sets a development one for you.
COMPUTER_TOKEN=
# Local only, and commented out because this file gets copied. Uncommenting it lets a Bot browse this
# machine's own services, which is what a laptop wants and what a deployment must never have: it
# lifts the private-address floor in browsing and in the endpoint a Bot may be registered against.
# The server refuses to start with it set under NODE_ENV=production.
# AGENT_COMPUTER_ALLOW_PRIVATE_HOSTS=true
#
# Private addresses an agent may be registered at, named one at a time, comma separated. This is what
# a deployment uses instead of the switch above: bring your own agent, running on your own network,
# without lifting the floor for browsing or for anything else.
#
# A host, optionally with a port. `agents.internal` covers any port on that host; `10.0.0.42:9000`
# pins that one. Matching is exact — no wildcards, no suffixes — and a URL or a `*` is refused at
# startup with the entry named, rather than silently never matching. The never-allowed addresses,
# cloud metadata among them, cannot be named back in. Unset means none, which is the default posture.
#
# AGENT_ENDPOINT_ALLOWED_HOSTS=agents.internal,10.0.0.42:9000
#
# What a Bot may do on its computer, as one JSON object. Absent uses the built-in default, which
# permits the acting tools and forbids nothing, and records every action either way.
#
# `deny` is evaluated first and beats `allow`. An empty `allow` permits nothing, a missing policy
# permits nothing, and a rule that fails to parse denies rather than letting the action through. The
# server refuses to start if this is set and malformed, so an invalid restriction never falls back to
# permissive behavior.
#
# Workspace and browser profile per Bot. Each Bot's computer is its own container with its own
# volumes, so one Bot cannot read another's files or use another's logins, and every action records
# which Bot took it. A rule can still restrict a single Bot with `bot.id`.
#
# Attributes: tool.name, intent, bot.id, actor.id, page.url, page.host,
#             element.ref/role/name/type, key, command, file.path, file.name, file.extension,
#             mcp.server, mcp.tool, mcp.effect, initiator.kind, initiator.id.
#
# Name every route to the same effect. A form submits from a keypress in any of its fields, so a rule
# that only blocks a Submit button does not block Enter from another field. The example below refuses
# Enter outright for that reason, from both tools that can press it: a key action, and a type action
# carrying `submit`.
# Functions: contains(haystack, needle) and matches(value, pattern), both case-insensitive.
# `enforce` blocks; `dry-run` decides and records but lets everything through, so a new rule can be
# tried against real traffic before it starts refusing anybody's work.
#
# AGENT_COMPUTER_POLICY={"mode":"enforce","deny":["(intent == \"activate\" && contains(element.name, \"submit\")) || ((tool.name == \"computer_key\" || tool.name == \"computer_type\") && key == \"Enter\")"],"allow":["true"]}

# How long one action waits for its element, in ms. Read by agent-computer, not the server.
# ACTION_TIMEOUT_MS=10000

# Extra environment variables a command on the computer may see, by name, comma-separated. The
# shell already receives PATH, locale, terminal and proxy variables. Proxy userinfo is stripped, so
# a password in HTTP_PROXY is not in `env`. It does not inherit the rest of this process, so
# KEY_ENCRYPTION_KEY and the other deployment secrets are not in `env`. Naming a secret or a
# credentialed proxy here is an operator's decision.
# COMPUTER_SHELL_ENV=JAVA_HOME,GOPATH

# ---------------------------------------------------------------------------
# The computer's profile and where its traffic leaves from
# ---------------------------------------------------------------------------

# Chromium profile directory inside agent-computer, mounted from the `agent-profiles` volume in
# docker-compose.yml. Pointing it somewhere unmounted disables login persistence.
# PROFILES_DIR=/profiles

# Browser process used by a Bot's computer. Managed mode always uses full Chromium. `headed` is the
# default wherever a hosted computer runs (Linux: a container, a pod, the desktop app's engine): full
# Chromium on the computer's own virtual display, behind the same live screen, which bot checks such
# as Cloudflare's challenge far less than headless. `headless` is still available, smaller, and the
# default only when the computer runs directly on macOS or Windows, where headed would open windows.
# COMPUTER_BROWSER_BACKEND=managed
# COMPUTER_BROWSER_MODE=headed

# Web Bot Auth: every request a Bot's browser makes is signed as coming from this deployment
# (Ed25519, HTTP Message Signatures), and the public key is published at
# <OPENBOT_PUBLIC_URL>/.well-known/http-message-signatures-directory. Off unless set to on, because
# it announces the deployment's URL to every site a Bot visits. `on` needs OPENBOT_PUBLIC_URL (or
# BETTER_AUTH_URL) to be https and not this machine, and is refused otherwise. It only earns anything
# once the deployment is registered with Cloudflare, a manual step: see docs/configuration.md.
# WEB_BOT_AUTH=on
# The signing key, an Ed25519 private key as a JSON Web Key. Unset derives one from
# KEY_ENCRYPTION_KEY, the same on every replica, so nothing new is needed to start. Never logged.
# WEB_BOT_AUTH_KEY=

# Opt-in installed Chrome on the same machine as a local API deployment:
# bun scripts/start-local-chrome-computer.ts
# The helper requires COMPUTER_TOKEN, binds 127.0.0.1:4101, and keeps dedicated per-Bot profiles.
# Set AGENT_COMPUTER_URL=http://127.0.0.1:4101 on the API, clear COMPUTER_SUPERVISOR_URL and
# COMPUTER_SANDBOX_NAMESPACE, then restart the API. See docs/configuration.md for full setup.
# Local mode requires headed; do not leave an explicit headless override set in its environment.
# COMPUTER_BROWSER_BACKEND=local-chrome
# COMPUTER_BROWSER_MODE=headed
# Optional absolute app-owned data root; defaults to the platform's OpenBot user-data directory.
# OPENBOT_LOCAL_COMPUTER_DIR=

# Which Bot this computer belongs to, and therefore which profile directory it uses.
# COMPUTER_BOT_ID=shared

# Per-Bot egress identity. A proxy the Bot's browser sends everything through, so the far side sees a
# stable address it can allow-list or attribute to that Bot. `EGRESS_PROXY_<BOT>` names one Bot,
# `EGRESS_PROXY_DEFAULT` covers the rest, and absent means the browser goes out directly.
#
# Credentials may be in the URL and are split out before Playwright sees them. Only the HOST is ever
# reported back on the admin page or the API, so the password does not end up on a screen.
#
# This is attribution, not anonymity, and it is not a boundary by itself: it gives a security team a
# per-Bot address for network rules alongside AGENT_COMPUTER_POLICY.
#
# These go in `egress.env` beside this file, NOT here. The names are per-Bot, so Compose cannot
# list them the way it lists every variable below, and it hands a container only what it is told to.
# In `.env` they reach no process and the browser goes out directly with nothing saying so.
#
#   EGRESS_PROXY_DEFAULT=http://user:password@proxy.internal:8080
#   EGRESS_PROXY_SALES_BOT=http://sales.proxy.internal:8080
#
# A residential or ISP proxy goes in the same place, and is the operator's choice to make knowingly:
# the Bots' traffic then leaves from an address a consumer ISP owns, so sites see what looks like a
# person at home rather than a datacenter. Off unless set. The egress filter still applies first.
#
#   EGRESS_PROXY_DEFAULT=http://customer-user:password@gateway.residential.example:8000

# ── Code sandbox ─────────────────────────────────────────────────────────────
# The container that runs OpenCode for the run_code tool. Unset AGENT_SANDBOX_URL (or set it
# empty) on the API and the run_code tool reports that code execution is not configured.
AGENT_SANDBOX_URL=http://127.0.0.1:4300
SANDBOX_TOKEN=openbot-dev-sandbox-token
SANDBOX_PORT=4300
# Per-bot lifecycle inside that container: every Bot works in its own workspace at
# /workspace/bots/<botId> behind its own opencode serve, so Bots cannot see each other's files.
# An idle serve is stopped after SANDBOX_UPSTREAM_IDLE_MS (default 10 minutes), checked every
# SANDBOX_SWEEP_INTERVAL_MS; SANDBOX_UPSTREAM_PORT_BASE is the first port a per-bot serve may
# take. SANDBOX_WORKSPACE_TTL_MS sweeps whole bot workspaces untouched for that long — 0 (the
# default) keeps it OFF, because deleting a user's files automatically must be an explicit choice.
SANDBOX_UPSTREAM_IDLE_MS=600000
SANDBOX_SWEEP_INTERVAL_MS=60000
SANDBOX_UPSTREAM_PORT_BASE=4400
SANDBOX_WORKSPACE_TTL_MS=0
# Unset by default (the build uses registry.npmjs.org). If the image build fails with
# "Fail extracting tarball" on the opencode binary packages, point the build at a mirror:
#   NPM_REGISTRY=https://registry.npmmirror.com
# The model route defaults to the same GLM endpoint the server itself uses (OPENAI_BASE_URL +
# OPENAI_API_KEY + BOT_MODEL); override the three SANDBOX_PROVIDER_* variables to route it
# elsewhere.

# ── Knowledge base (KB-Service, split out of WeKnora) ────────────────────────
# KB-Service is a separate service (parse/chunk/embed/retrieve); OpenBot talks to it over HTTP
# with KB_SERVICE_URL / KB_SERVICE_API_KEY (see server/src/knowledge/config.ts). The four
# KB_RETRIEVAL_* variables below decide what the CONVERSATION side does: middleware injects
# reference material into every run and the search_knowledge tool re-queries on demand.
#
# KB_RETRIEVAL_KB_IDS is the switch for that whole feature — comma-separated kb ids, applied
# globally (per-person kb binding is not in P1; the API key's tenant domain is the boundary).
# Empty or unset means retrieval stays off: no middleware is mounted and no tool is registered,
# even when KB_SERVICE_URL is set.
# KB_RETRIEVAL_TOP_K: per-kb top_k and the merged global cap (default 5, range 1..10).
# KB_RETRIEVAL_TIMEOUT_MS: per-request timeout on the middleware path only (default 1500,
# range 100..10000) — several kbs run concurrently, so wall-clock is about one timeout. The
# tool path waits up to KB_SERVICE_TIMEOUT_MS (10s) instead: a model's deliberate query can
# afford the wait; a chat turn cannot.
# KB_RETRIEVAL_SCORE_THRESHOLD: passed through to the upstream filter (default 0 = off).
# Skeleton-phase scores are RRF fusion values with no absolute meaning, so a non-zero default
# would silently drop every result; recalibrate after real embeddings/rerank land.
# KB_SERVICE_URL=http://kb-service:8081
# KB_SERVICE_API_KEY=
# KB_RETRIEVAL_KB_IDS=kb-fintech-policy,kb-faq
# KB_RETRIEVAL_TOP_K=5
# KB_RETRIEVAL_TIMEOUT_MS=1500
# KB_RETRIEVAL_SCORE_THRESHOLD=0

# ── Knowledge-base service itself (kb domain, formerly kb-mastra; server/src/kb) ──
# The service OpenBot's KB_SERVICE_URL points at lives in server/src/kb (HTTP:
# `bun run kb:dev`, ingest worker: `bun run kb:worker`; port 8082, 8081 stays the Go
# fallback). Its own variables, all optional for OpenBot itself — the service reads
# them, the server only needs KB_SERVICE_URL/KB_SERVICE_API_KEY above:
# KB_PORT=8082
# Own database and role on the shared postgres (docker/kb-mastra/init-db.sql; vectors
# are in Qdrant, this database holds the four metadata tables only):
# KB_DATABASE_URL=postgres://kb_mastra:kb_mastra@localhost:5432/kb_mastra
# BullMQ ingest queue (a Redis the service can reach; loopback in local development):
# KB_REDIS_URL=redis://localhost:6379
# KB_QDRANT_BATCH=40
# API keys, `<key>:<tenant>:<role>[:kb1,kb2]`, `;`-separated (first entry is what
# KB_SERVICE_API_KEY above must match):
# KB_API_KEYS=sk-kb-dev-001:tenant-a:admin
# DocReader (WeKnora's gRPC document parser, docker/compose/kb.yml docreader):
# DOCREADER_ADDR=localhost:50051
# DOCREADER_CALL_TIMEOUT_MS=1800000
# Embedding (OpenAI-compatible /api/embeddings; dimensions must match the Qdrant
# collection — changing models means a new collection and full re-embed):
# OLLAMA_BASE_URL=http://localhost:11434
# KB_EMBED_MODEL=
# KB_EMBED_DIMENSIONS=1024
# BATCH_EMBED_SIZE=5
# KB_EMBED_MAX_CONCURRENCY=32
# KB_RERANK_ENABLED=false
# KB_RERANK_URL=
# KB_RERANK_MODEL=
# STORAGE_TYPE=local
# STORAGE_LOCAL_PATH=./data/kb-files
# MAX_FILE_SIZE_MB=50
# KB_VECTOR_THRESHOLD=0.15
# KB_KEYWORD_THRESHOLD=0.3
# KB_DEFAULT_TOP_K=50
# KB_RERANK_TOP_K=10
# KB_RERANK_THRESHOLD=0.2

# ── Vector store (Qdrant) ───────────────────────────────────────────────────
# Qdrant is the one vector database: embedding writes, updates, deletes and similarity
# search all go through it. PostgreSQL has carried no vector column since migration
# 0010 dropped the document index, so there is nothing to configure on the Postgres
# side. The kb compose file (docker/compose/kb.yml) runs qdrant/qdrant pinned
# (QDRANT_IMAGE override available) with storage on the named `openbot_qdrant-data`
# volume, published on loopback only.
# QDRANT_URL=http://localhost:6333
# QDRANT_API_KEY=

# ── Workshop / Redis ─────────────────────────────────────────────────────────
# This URL, not REDIS_URL: that name belongs to Lago inside Compose, and Bun's built-in client
# connects to whatever REDIS_URL says the moment it is imported. Leave this empty and the
# workshop runs single-replica with an in-process lock — deliberately, never silently: see
# WORKSHOP_REQUIRE_REDIS below. Point it at the openbot-redis service (from the host,
# 127.0.0.1:6379 by default) in any multi-replica deployment.
OPENBOT_REDIS_URL=
# Fail startup when Redis is expected but unreachable. Set 1 in any multi-replica deployment.
WORKSHOP_REQUIRE_REDIS=0
# Lock TTL and renewal cadence. Renewal is TTL/3, so three missed renewals is one lost lock.
WORKSHOP_LOCK_TTL_MS=30000
# Turn event fan-out. "auto" picks redis when the URL above is set, else database polling.
WORKSHOP_FANOUT=auto

# ── Workshop / preview & dev servers ─────────────────────────────────────────
# The workshop feature switch. Flip to false to hide the workshop tab and 404 its routes
# without touching anything else.
WORKSHOP_ENABLED=true
# Preview mode: "auto" (dev server when per-bot containers are ready, static otherwise),
# "static", "devserver" or "off". See docs/configuration.md before choosing.
WORKSHOP_PREVIEW_MODE=auto
# Explicit allow-list of scheme://host:port origins that may reach a dev-server preview
# (Vite's allowedDevOrigins, enforced server-side). Anything not listed is refused. Empty
# means no dev origin is trusted.
PREVIEW_ALLOWED_DEV_ORIGINS=

# ── Sandbox: webapp previews, activity timeout, per-bot dev servers ──────────
# First port of the sandbox's per-bot webapp (static build) pool; 100 ports from here.
SANDBOX_WEBAPP_PORT_BASE=4500
# A run whose stream stays silent longer than this is ended with a timeout (default 5 min).
SANDBOX_ACTIVITY_TIMEOUT_MS=300000
# First port of the per-bot dev server pool (vite et al.); 100 ports from here.
SANDBOX_DEVSERVER_PORT_BASE=4600
# How many per-bot dev servers may run at once. The next start is refused, never queued.
SANDBOX_DEVSERVER_MAX=8
# First port of the sandbox's per-bot dev-server pool; 100 ports from here, never overlapping
# the opencode (4400) or webapp (4500) pools.
# An idle dev server is stopped after this long (default 15 min — longer than opencode's 10,
# because somebody editing a page stops to think).
SANDBOX_DEVSERVER_IDLE_MS=900000
# At most this many dev servers run at once; beyond the cap the request is refused loudly, not
# queued. Budget note: cap × per-container memory (default 8 × 2g = 16g) — check the host
# before raising either.


# The managed coworker AG-UI endpoint. Optional: use an HTTP(S) URL, and set MANAGED_AGENT_TOKEN
# with it. A URL with no token refuses to start; a leftover token with no URL is ignored.
#
# Unset in the one-container image, which does not carry a Bot. `scripts/start.sh` points this at
# agent-langgraph on 4201 for a laptop. The proof-of-concept on 4200 hand-writes the protocol and
# leaves the loop to whatever is watching, so it is a reference rather than something to build a
# deployment on.
# MANAGED_AGENT_AG_UI_URL=http://localhost:4201/ag-ui

# Shared secret sent by the server on every call to a managed Bot, as the `x-openbot-agent-token`
# header. Required together with the URL above; the server starts without either.
#
# `scripts/start.sh` generates one and writes it back here on first run, so leaving this empty is
# fine locally. Set it yourself for a deployment: openssl rand -base64 32
MANAGED_AGENT_TOKEN=

# The second Bot in the box runs on http://localhost:4201/ag-ui, on a framework rather than
# proof of concept, and is reached the same way: point MANAGED_AGENT_AG_UI_URL at it, or add it as a
# Bot of its own in the tenant package or at /bots.

# Which model the Bots use. BOT_MODEL is the framework Bot's: it defaults to gpt-5.5 and switches
# to the Responses API by itself for a model that needs it — a 5.6 tier does, because 5.6 rejects
# function tools on /v1/chat/completions.
#
# The proof-of-concept Bot has its own, AGENT_BOT_MODEL, defaulting to gpt-5.5, because it writes
# that endpoint by hand and refuses to start on a model whose tools it cannot use. One variable for
# both would mean setting the framework Bot's model quietly took the other one's tools away.
# AGENT_BOT_MODEL=gpt-5.5
# BOT_RESPONSES_API=false

# The Go Bot (agent-trpc) has its own pair, for the same reason the proof-of-concept Bot has
# AGENT_BOT_MODEL: pointing it at an OpenAI-compatible endpoint (GLM, vLLM, Ollama…) and naming
# that endpoint's model must not quietly move every other Bot off the shared model config.
# Unset, both fall back to the shared OPENAI_* chain and the bots.agent-trpc row's gpt-5.5.
# AGENT_TRPC_BASE_URL=https://open.bigmodel.cn/api/coding/paas/v4
# AGENT_TRPC_MODEL=GLM-5.3

# One computer per Bot. Unset, every Bot shares the computer at AGENT_COMPUTER_URL, suitable on a
# laptop and explicit about being one shared machine. Set, the supervisor gives each Bot a container
# of its own, with its own /workspace and its own browser profile.
COMPUTER_SUPERVISOR_URL=
# Shared with the supervisor. Not the security boundary, its four verbs are, but it keeps anything
# else that can reach the port from cycling a Bot's computer.
SUPERVISOR_TOKEN=
# Set to runsc to run every computer under gVisor, if the host has it. Unset, a computer is an
# ordinary container and shares the host kernel, which is worth knowing when the Bot is not ours.
COMPUTER_RUNTIME=

# The secret a framework Bot presents when it calls a tool back through this server. A Bot runs its
# own loop, in its own process, and still may not reach a vendor directly: it calls the deployment
# that granted the tool, which is where the grant, the policy and the audit row are. Absent, no Bot
# may call tools back and it is told so rather than being quietly allowed.
AGENT_TOOL_TOKEN=

# The secret the routine worker presents when it hands a run back to this server. It authenticates
# the handoff of one routine run id, and nothing else: the server re-reads the routine, the Bot and
# everything else it needs from the database, so the worker cannot use this to inject an instruction.
#
# Left empty, the internal endpoint refuses every call and no routine ever fires — the correct state
# for a deployment that has not stood up a worker. Set for one that has: openssl rand -base64 32.
# `scripts/start.sh` falls back to a fixed development value locally. Do not accept a default in
# production.
WORKER_SHARED_SECRET=

# Composio, the broker that holds people's accounts for a few hundred apps, so a Bot can act in Gmail
# or Slack or Notion without this deployment registering an OAuth client with each of them.
#
# Optional. Without this key there is nothing to connect, nothing to grant, and no Composio tool for
# a Bot to call. What does remain is one row that goes nowhere, under "More apps" on the admin
# Plugins page, saying that adding a Composio key enables a catalogue of tools and naming this
# variable — the feature is named rather than hidden, so an administrator who has heard of Composio
# can find out what it wants. There is no directory to browse, no picker, and no brokered app on
# anybody's connected-accounts page.
#
# This variable is the whole of the setting. There is no screen anywhere in the product that sets it:
# it is read from this environment at startup, and an administrator with every permission there is
# cannot turn Composio on from a page.
#
# One key for the whole deployment, not one per person. Composio keeps people apart by a user id sent
# with every call, so one account's connections are never reachable from another's.
COMPOSIO_API_KEY=

# OpenConnector, the self-hosted broker this repository's docker-compose runs as the `open-connector`
# service and publishes at OPENCONNECTOR_URL (http://localhost:3100 by default). Unlike Composio it
# is a container of this deployment's own: the credentials people type stay in its volume, encrypted
# by the container when OPENCONNECTOR_ENCRYPTION_KEY is set.
#
# Two tokens, because the container has two faces and separates them itself: the admin token speaks
# for its management endpoints (the directory, the connections), the runtime token for action
# execution. BOTH must be set for the server to treat the broker as configured. Unset is the
# supported default: one inert row under "More apps" on the admin Plugins page, no directory to
# browse, and no brokered app on anybody's connected-accounts page.
OPENCONNECTOR_ADMIN_TOKEN=
OPENCONNECTOR_RUNTIME_TOKEN=
# Encrypts (AES-256-GCM) the credentials the container keeps in its /app/data volume. Unset, what
# people type rests unencrypted on that volume — worth deciding before the first connection rather
# than after it.
OPENCONNECTOR_ENCRYPTION_KEY=

# ---------------------------------------------------------------------------
# Linking people's GitHub accounts
# ---------------------------------------------------------------------------

# A GitHub App lets people link their GitHub account under Settings -> Connected accounts -> Linked
# accounts. Register the App's callback URL as <public URL>/api/identity/github/callback and keep
# "Expire user authorization tokens" on. A webhook is not needed for linking. Set both the client id
# and the client secret, or neither: one without the other stops the server at start-up, and so does
# setting them with no public URL (OPENBOT_PUBLIC_URL or BETTER_AUTH_URL). People must be signed in
# to OpenBot in the same browser to connect. Afterwards the browser returns to OPENBOT_APP_URL, which
# you need when the app and the server are on different origins.
# GITHUB_APP_CLIENT_ID=
# GITHUB_APP_CLIENT_SECRET=

# ---------------------------------------------------------------------------
# Reaching people outside the app: Slack, Teams, SMS, push
# ---------------------------------------------------------------------------

# Slack and Microsoft Teams arrive through an OpenTag deployment, which calls this server as its
# AG-UI agent at <public URL>/api/delivery/webhooks/opentag/agent. The secret is at least 32
# characters and is the same value as OpenTag's AGENT_AUTH_HEADER bearer token. OPENTAG_URL is
# where messages go when no Slack or Teams turn is open (replies after an approval, questions,
# progress); without it those sends fail visibly. Setting OPENTAG_URL or the icon without the secret
# stops the server at start-up. The former SLACK_* settings are refused at start-up.
# OPENTAG_SHARED_SECRET=
# OPENTAG_URL=https://opentag.example.com
# OPENTAG_BOT_ICON_URL_TEMPLATE=https://avatars.example.com/{seed}.png

# The public origin providers call back on, when it is not OPENBOT_PUBLIC_URL or BETTER_AUTH_URL (a
# tunnel, say). Twilio signs over the URL it was given, so this must match the Twilio number's setting.
# DELIVERY_PUBLIC_URL=https://hooks.example.com

# SMS. All four or none: some but not all stops the server at start-up. Point the number's incoming
# webhook at <DELIVERY_PUBLIC_URL>/api/delivery/webhooks/sms.
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_VERIFY_SERVICE_SID=
# TWILIO_FROM_NUMBER=

# ---------------------------------------------------------------------------
# Billing: paid plans through Lago
# ---------------------------------------------------------------------------

# All optional. A deployment that sets none of the LAGO_* variables has no billing surfaces at all —
# no webhook door, no entitlements read, no admin billing page. Setting LAGO_API_URL or
# LAGO_API_KEY alone stops the server at start-up: the pair is all-or-nothing.
#
# LAGO_API_URL is the provider ORIGIN, for example https://api.getlago.com. The client adds the
# /api/v1 prefix itself, so a URL ending in /api/v1 (the shape the provider's own SDK documents) is
# refused at start-up with this reminder. The URL is vetted against the outbound policy before the
# server starts: it must be http or https and must not name a loopback, private, link-local or
# reserved address. LAGO_ALLOW_PRIVATE_HOSTS=true relaxes that to loopback and RFC1918 only, for
# developing against a Lago stack on your own machine; the cloud metadata addresses are never in it.
#
# Webhooks arrive at <public URL>/api/billing/webhooks/lago. The verification key is one of two
# kinds, and exactly one: LAGO_WEBHOOK_PUBLIC_KEY (the RS256 public key PEM, as written or base64
# wrapped) when the provider endpoint was created with the jwt algorithm — the default — or
# LAGO_WEBHOOK_SECRET (the endpoint's HMAC Signature Token) when it was created with hmac. Setting
# both stops the server; setting neither leaves the API side working with no webhook door mounted.
#
# LAGO_PLAN_ENTITLEMENTS maps each plan code to the entitlement codes it grants, as JSON:
# {"pro": ["intelligence", "teams"]}. Malformed JSON stops the server at start-up.
# LAGO_REQUEST_TIMEOUT_MS caps one provider request (default 10000).
#
# LAGO_PLAN_QUOTAS maps each plan code to the metered ceilings it includes — the "已用 / 总量" the
# 套餐用量 page draws. Each entry names a metricCode, a whole-number limit, and optionally the
# metricName and unit to show:
# {"pro": [{"metricCode":"llm_tokens","metricName":"模型 tokens","unit":"tokens","limit":2000000}]}
# A metric that is metered but appears in no plan is still shown, as 「计量中，不限量」 — the meter is
# running; this deployment simply set no ceiling. Left empty, everything reads uncapped.
#
# LAGO_PLAN_CATALOG maps each plan code to the catalog entry the 「升级套餐」 dialog draws — name,
# monthly base credits, benefit list, and per-cycle pricing (priceCents is the settled amount in
# cents; originalCents/discountLabel are optional and named when the cycle is sold at a discount).
# Both the price AND the benefit list (features) are ops-configurable; nothing is hardcoded in the
# UI. The three tiers below are examples — set your own names, credits, features and prices:
# {"standard":{"name":"标准版","credits":4000,"features":["每月基础积分","基础模型"],"pricing":[
#   {"code":"recurring_monthly","label":"连续包月","priceCents":4900,"originalCents":6900,"discountLabel":"7折","unit":"month"},
#   {"code":"monthly","label":"1个月","priceCents":6900,"unit":"month"},
#   {"code":"recurring_yearly","label":"连续包年","priceCents":47040,"originalCents":84000,"discountLabel":"5.6折","unit":"year"},
#   {"code":"yearly","label":"1年","priceCents":58800,"originalCents":84000,"discountLabel":"7折","unit":"year"}]},
#  "advanced":{"name":"高级版","credits":9000,"features":["每月基础积分","全部模型可选"],"pricing":[
#   {"code":"recurring_monthly","label":"连续包月","priceCents":14000,"originalCents":19900,"discountLabel":"7折","unit":"month"},
#   {"code":"monthly","label":"1个月","priceCents":19900,"unit":"month"},
#   {"code":"recurring_yearly","label":"连续包年","priceCents":134400,"originalCents":240000,"discountLabel":"5.6折","unit":"year"},
#   {"code":"yearly","label":"1年","priceCents":168000,"originalCents":240000,"discountLabel":"7折","unit":"year"}]},
#  "flagship":{"name":"旗舰版","credits":50000,"features":["每月基础积分","全部模型可选","优先响应"],"pricing":[
#   {"code":"recurring_monthly","label":"连续包月","priceCents":39900,"originalCents":56900,"discountLabel":"7折","unit":"month"},
#   {"code":"monthly","label":"1个月","priceCents":56900,"unit":"month"},
#   {"code":"recurring_yearly","label":"连续包年","priceCents":383040,"originalCents":684000,"discountLabel":"5.6折","unit":"year"},
#   {"code":"yearly","label":"1年","priceCents":478800,"originalCents":684000,"discountLabel":"7折","unit":"year"}]}}
# cycle code is one of recurring_monthly | monthly | recurring_yearly | yearly; unit defaults from it.
# The order of the keys is the order the dialog shows the tiers. Left empty, the dialog has no plan
# to draw and the upgrade entry is hidden.
# LAGO_API_URL=https://api.getlago.com
# LAGO_API_KEY=
# LAGO_WEBHOOK_PUBLIC_KEY=
# LAGO_WEBHOOK_SECRET=
# LAGO_ALLOW_PRIVATE_HOSTS=false
# LAGO_PLAN_ENTITLEMENTS={}
# LAGO_PLAN_QUOTAS={}
# LAGO_PLAN_CATALOG={}
# LAGO_REQUEST_TIMEOUT_MS=10000

# ── Billing hard-cap credit policy ─────────────────────────────────────────────────────────────
# All FOUR keys are required together. If any is missing, malformed, negative, or has a zero
# denominator, the policy resolves to `configured: false` and EVERY metered model call and code
# run is refused before the provider is invoked — the server logs
# `billing-credit-policy-unconfigured` with the offending keys at boot, and the refusal reaches
# the caller as `credit_policy_unconfigured` (not "no credits left").
# Rates are exact rationals in scaled credit units per token (CREDIT_SCALE = 100): one credit per
# 100 tokens is {"numerator":"1","denominator":"100"}. Integers may be JSON numbers or quoted
# decimal strings; quote anything outside the safe-integer range.
# The maximum reservation for one call is DERIVED, not configured: the server computes
#   ceil(input_max_tokens × input_rate) + ceil(output_max_tokens × output_rate)
# with integer ceiling arithmetic, so a call always holds its own worst case. With the example
# values below one call holds 21.00 credits (128000/100 + ceil(16384/20) = 1280 + 820 = 2100
# scaled units) — a balance below that admits no call at all. Size the token maxima with that
# floor in mind.
# BILLING_MODEL_CREDIT_RATES={"GLM-5.3":{"input":{"numerator":"1","denominator":"100"},"output":{"numerator":"1","denominator":"20"}}}
# BILLING_MODEL_MAX_RESERVATION_TOKENS={"GLM-5.3":{"input":"128000","output":"16384"}}
# BILLING_CODE_RUN_CREDIT_RATE={"numerator":"1","denominator":"100"}
# BILLING_CODE_RUN_MAX_RESERVATION_TOKENS="100000"

# Push to the native app in mobile/. EXPO_PROJECT_ID is the app's EAS project UUID and switches push
# and native-app sign-in on; a device registers only when the app reports the same id. The access token is optional and is
# sent to Expo's push service as a bearer token.
# EXPO_PROJECT_ID=00000000-0000-0000-0000-000000000000
# EXPO_ACCESS_TOKEN=

# Which native client's URL scheme the OAuth redirect may return to. The built-in client
# (mobile/) uses openbotmobile://; the OpenMuse client (apps/openmuse submodule, apps/mobile)
# registers openmuse:// and needs this set to receive its sign-in callback. Only takes effect when
# EXPO_PROJECT_ID above is set. Must be a bare scheme (letters, digits, +, ., -), never a
# full URL: this list is the trust base for where a session cookie may be redirected.
# EXPO_APP_SCHEME=openmuse

# ---------------------------------------------------------------------------
# Inbound email triggers
# ---------------------------------------------------------------------------

# Amazon SES receiving for this domain publishes to an SNS topic subscribed to
# <public URL>/api/events/email/sns. Each email trigger's address is trigger-<id>@<domain>. Both
# are needed; without them email triggers have no address. Messages from any other topic are refused.
# OPENBOT_INBOUND_EMAIL_DOMAIN=in.example.com
# OPENBOT_INBOUND_EMAIL_SNS_TOPIC_ARNS=arn:aws:sns:us-east-1:123456789012:openbot-inbound

# ---------------------------------------------------------------------------
# Directory provisioning and audit export
# ---------------------------------------------------------------------------

# SCIM 2.0 at <BETTER_AUTH_URL>/api/auth/scim/v2, on only while the token is set. The _NEXT token is
# accepted alongside it while a directory moves to a new one.
#   openssl rand -base64 32
# SCIM_BEARER_TOKEN=
# SCIM_BEARER_TOKEN_NEXT=
# SCIM_CONNECTION_ID=directory

# Every audit row as an OTLP log record over HTTP, for a SIEM or an OpenTelemetry Collector. Either
# endpoint switches it on: the logs endpoint is used as written, the generic one gets /v1/logs.
# Headers are key=value pairs separated by commas. OPENBOT_OTEL_EXPORT=off turns it off with an
# endpoint still set.
# Distributed traces ride the same generic endpoint: every serving process spans its HTTP requests
# there and /v1/traces is appended for them. The traces endpoint below is used verbatim instead
# when a full path is needed. OPENBOT_TRACES=off turns tracing off with an endpoint still set.
# OTEL_EXPORTER_OTLP_ENDPOINT=https://collector.example.com:4318
# OTEL_EXPORTER_OTLP_LOGS_ENDPOINT=
# OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=
# OTEL_EXPORTER_OTLP_HEADERS=x-api-key=change-me
# OTEL_EXPORTER_OTLP_LOGS_HEADERS=
# OTEL_SERVICE_NAME=openbot
# OPENBOT_OTEL_EXPORT=off
# OPENBOT_TRACES=off

# The local observability stack:
#   docker compose --project-directory . -f docker/compose/observability.yml up -d
# starts Grafana, Loki, Tempo, Prometheus and Alloy. Published loopback ports when it runs (every one has a
# *_PORT override in this file's convention):
#   Grafana     http://127.0.0.1:3003   (starter dashboard auto-provisioned)
#   Loki        http://127.0.0.1:3102   (3100 is open-connector's)
#   Tempo       http://127.0.0.1:3200   OTLP receiver on 4318 (HTTP) / 4317 (gRPC)
#   Prometheus  http://127.0.0.1:9090
#   Alloy       http://127.0.0.1:12345  (pipeline debug UI)
# Uncomment the endpoint below once the stack is up, then restart the server, and its audit
# logs and traces land in the stack (traces in Tempo, everything in Grafana).
#GRAFANA_PORT=3003
#LOKI_PORT=3102
#TEMPO_PORT=3200
#TEMPO_OTLP_HTTP_PORT=4318
#TEMPO_OTLP_GRPC_PORT=4317
#PROMETHEUS_PORT=9090
#ALLOY_PORT=12345
# OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:4318

# In-container services (agent-bot, agent-computer, supervisor) export their traces to Tempo
# through the compose network, not your loopback. Uncomment when the observability stack is up
# and recreate them (`docker compose up -d agent-bot agent-computer supervisor`); empty keeps
# them recording locally without exporting.
#CONTAINER_OTEL_EXPORTER_OTLP_ENDPOINT=http://tempo:4318

# Crash reporting sink, same stack:
#   docker compose --project-directory . -f docker/compose/observability.yml up -d
# starts GlitchTip on http://127.0.0.1:8001. Its SECRET_KEY is forced — generate one once with
# `openssl rand -hex 32` and put it here; the stack refuses to start without it, on purpose
# (Django signs sessions and password resets with it).
#GLITCHTIP_PORT=8001
#GLITCHTIP_SECRET_KEY=
# After the first boot, mint the admin and the project DSN once — docs/observability.md has the
# full walkthrough. One DSN per client, all against the same GlitchTip:
#SENTRY_DSN_WEB=http://<key>@127.0.0.1:8001/<project>
#SENTRY_DSN_MOBILE=http://<key>@127.0.0.1:8001/<project>
#SENTRY_DSN_DESKTOP=http://<key>@127.0.0.1:8001/<project>

# ---------------------------------------------------------------------------------------------
# Opik — self-hosted AI observability and evaluation. OPTIONAL and OFF by default.
#
# The stack lives in docker/compose/opik.yml and the pinned image tags and digests live in
# docker/opik/versions.json. Start it from the repository root:
#   docker compose --project-directory . -f docker/compose/opik.yml up -d
# Guide: docs/opik.md.
#
# OTLP is published on 5418/5417, not the upstream 4318/4317, because the LGTM stack in
# docker/compose/observability.yml already owns those on loopback for Tempo.
#
# Leaving OPIK_ENABLED unset or off must not change Agent execution or existing tracing.
# ---------------------------------------------------------------------------------------------
#OPIK_ENABLED=off
#OPIK_BASE_URL=http://127.0.0.1:5174/api
#OPIK_API_KEY=
#OPIK_WORKSPACE_NAME=default
#OPIK_PORT=5174
#OPIK_OTLP_HTTP_PORT=5418
#OPIK_OTLP_GRPC_PORT=5417
# The stack's own datastore credentials. Required by the compose file (`:?`), so set them in
# .env before `up` (an empty value still refuses to start, on purpose); never commit real
# values. MinIO needs a root password of 8+ characters. The "" placeholders stay empty.
#OPIK_MYSQL_PASSWORD=""
#OPIK_MYSQL_ROOT_PASSWORD=""
#OPIK_CLICKHOUSE_PASSWORD=""
#OPIK_REDIS_PASSWORD=""
#OPIK_MINIO_ROOT_USER=""
#OPIK_MINIO_ROOT_PASSWORD=""

# Log level for every OpenBot process (fatal|error|warn|info|debug|trace). Alias: OPENBOT_LOG_LEVEL.
LOG_LEVEL=info

# Optional: OpenConnector egress allowlist. Only needed when a local proxy/VPN maps public
# domains into reserved IP ranges (fake-IP DNS), which the broker refuses by design.
OPENCONNECTOR_EGRESS_TRUSTED_HOSTS=

# OpenConnector's database. docker-compose.yml already gives the broker its own `openconnector`
# database on the shared postgres (docker/openconnector/init-db.sql), so this only needs setting
# to point the broker somewhere else, such as a deployment's external Postgres. First start on a
# fresh database needs: docker compose --project-directory . -f docker/compose/services.yml run --rm open-connector npm run runtime:migrate
#OPENCONNECTOR_DATABASE_URL=postgres://openconnector:openconnector@postgres:5432/openconnector

# ---------------------------------------------------------------------------
# Enterprise entry (bun run dev:enterprise / start:enterprise) — optional, off by default.
# Requires its own identity provider config (loadIdentityConfig) plus:
#   ENTERPRISE_AUTH_DATABASE_URL / ENTERPRISE_DIRECTORY_DATABASE_URL / ENTERPRISE_DATA_DATABASE_URL
#   (one database, three least-privilege login roles), ENTERPRISE_ALLOWED_ORIGINS,
#   ENTERPRISE_AUTH_ROUTES. See server/src/enterprise/config.ts.
#ENTERPRISE_PORT=3101

# The Go runtime candidate block: set NOTHING and the candidate stays disabled (no routes, no
# pools). Setting ANY key requires the full set below; see server/src/enterprise/runtime/config.ts.
# The Go service itself is started with `docker compose --profile go-runtime up go-runtime`.
#ENTERPRISE_RUNTIME_SERVICE_CREDENTIAL=change-me-shared-with-go-runtime
#ENTERPRISE_RUNTIME_SERVICE_ID=runtime-go-1
#ENTERPRISE_RUNTIME_EXECUTION_URL=http://127.0.0.1:4202/internal/enterprise/v1/runtime/execution
#ENTERPRISE_RUNTIME_CANCEL_URL=http://127.0.0.1:4202/internal/enterprise/v1/runtime/cancel
#ENTERPRISE_RUNTIME_RUN_WRITER_DATABASE_URL=postgres://ob_run_writer:...@localhost:5432/openbot
#ENTERPRISE_RUNTIME_RUNTIME_WRITER_DATABASE_URL=postgres://ob_runtime_writer:...@localhost:5432/openbot
#ENTERPRISE_RUNTIME_MODEL_BASE_URL=https://open.bigmodel.cn/api/paas/v4
#ENTERPRISE_RUNTIME_MODEL_ALIAS=GLM-5.3
#ENTERPRISE_RUNTIME_MODEL_CREDENTIAL=
#ENTERPRISE_RUNTIME_MODEL_ROUTE_REF=glm-53-default
#ENTERPRISE_RUNTIME_EXPERT=assistant-v1=/path/to/runtime-go/experts/assistant-v1.txt
#ENTERPRISE_RUNTIME_GOVERNED_TOOLS=enterprise_echo=v1
#ENTERPRISE_RUNTIME_BUDGET_CAP_MICROS=2000000
#ENTERPRISE_RUNTIME_BUDGET_CURRENCY=USD
#ENTERPRISE_RUNTIME_LEASE_TTL_MS=600000
#ENTERPRISE_RUNTIME_CAPABILITY_TTL_MS=300000

# Email + password sign-in (Better Auth emailAndPassword), for clients without an OAuth
# browser such as the OpenMuse mobile app. Off by default; SSO-mandatory deployments
# still refuse it through decideSignInMethod.
# OPENBOT_EMAIL_PASSWORD=false
