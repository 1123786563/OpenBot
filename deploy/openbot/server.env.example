# Copy to .env.server. Generate the key with openssl rand -base64 32.
KEY_ENCRYPTION_KEY=
OPENBOT_SINGLE_USER=true
OPENBOT_PUBLIC_URL=http://127.0.0.1:18001
DEPLOYMENT_ID=openbot

# Use a model provider key. For Bifrost, use its virtual key and a URL reachable from the API.
OPENAI_API_KEY=
# OPENAI_BASE_URL=
# BOT_MODEL=

# Use the same tokens as the Agent Compose .env.
MANAGED_AGENT_AG_UI_URL=http://agent-langgraph:4201/ag-ui
MANAGED_AGENT_TOKEN=
AGENT_COMPUTER_URL=http://agent-computer:4100
COMPUTER_SUPERVISOR_URL=http://supervisor:4300
COMPUTER_TOKEN=
SUPERVISOR_TOKEN=
AGENT_TOOL_TOKEN=

# To enable OTLP audit export, match DEPLOYMENT_ID to the Collector's OPENBOT_DEPLOYMENT_ID.
# OTEL_EXPORTER_OTLP_LOGS_ENDPOINT=http://otel-collector:4318/v1/logs
# OPENBOT_OTEL_EXPORT=on
# OPENBOT_OPENOBSERVE_URL=http://127.0.0.1:15080
