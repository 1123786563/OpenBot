# Recommended: ./deploy/deploy.sh init
# New installations only. Existing installations must carry their original secrets and data.
CENTRAL_NETWORK=openbot-central
POSTGRES_ADMIN_PASSWORD=
MYSQL_ROOT_PASSWORD=
OPENBOT_DB_PASSWORD=
BIFROST_DB_PASSWORD=
HINDSIGHT_DB_PASSWORD=
INFISICAL_DB_PASSWORD=
OPENOBSERVE_DB_PASSWORD=
SPIRE_DB_PASSWORD=
FLEXPRICE_DB_PASSWORD=
TEMPORAL_DB_PASSWORD=
OPIK_MYSQL_PASSWORD=
OPIK_CLICKHOUSE_PASSWORD=
FLEXPRICE_CLICKHOUSE_PASSWORD=
# Hex only; shared data-node and Sentinel credentials are separate.
REDIS_PASSWORD=
REDIS_SENTINEL_PASSWORD=
REDIS_MAXMEMORY=512mb
RUSTFS_IMAGE=rustfs/rustfs:1.0.7
RUSTFS_ACCESS_KEY=
RUSTFS_SECRET_KEY=
# Create a dedicated RustFS access key restricted to the opik bucket before starting Opik.
OPIK_S3_ACCESS_KEY=
OPIK_S3_SECRET_KEY=
# Must be reachable from BOTH application containers and browsers. Configure DNS + TLS first.
OPIK_S3_ENDPOINT=
OPIK_BROWSER_ORIGIN=http://localhost:15173
OPIK_S3_PUBLIC_DOWNLOAD=false
OPIK_AUTH_USERNAME=admin
OPIK_AUTH_PASSWORD=
OPIK_PORT=15173
INFISICAL_ENCRYPTION_KEY=
INFISICAL_AUTH_SECRET=
INFISICAL_SITE_URL=http://localhost:18082
INFISICAL_PORT=18082
HINDSIGHT_CP_ACCESS_KEY=
HINDSIGHT_API_TENANT_API_KEY=
HINDSIGHT_HF_HUB_OFFLINE=0
HINDSIGHT_PORT=18888
HINDSIGHT_CONSOLE_PORT=19999
BIFROST_SETUP_TOKEN=
BIFROST_DB_HOST=postgres
BIFROST_DB_PORT=5432
BIFROST_DB_NAME=bifrost
BIFROST_DB_USER=bifrost
BIFROST_DB_SSL_MODE=disable
BIFROST_PORT=18080
OPENOBSERVE_ROOT_EMAIL=
OPENOBSERVE_ROOT_PASSWORD=
OPENOBSERVE_PORT=15080
OPENBOT_DEPLOYMENT_ID=
OPENOBSERVE_RUNTIME_AUTHORIZATION=
OPENOBSERVE_AUDIT_AUTHORIZATION=
OTEL_COLLECTOR_PORT=14318
# Set absolute path if runtime logs are stored outside deploy/openobserve/runtime-logs.
# OPENBOT_RUNTIME_LOG_DIR=
# Build from revision ab53a6a7edef647bf9e68440f3f69d0c69fc0028 or a verified release containing Sentinel support.
FLEXPRICE_IMAGE=
FLEXPRICE_PORT=18083
# Generate a join token from this deployment's SPIRE Server; never reuse another deployment's token.
SPIRE_JOIN_TOKEN=
# Main application settings remain in deploy/openbot/.env.server and deploy/agents/.env.
OPENBOT_IMAGE=
DATABASE_URL=postgresql://openbot:${OPENBOT_DB_PASSWORD}@postgres:5432/openbot?sslmode=disable
WORKER_SHARED_SECRET=
OPENBOT_PORT=18001

# Generated by the platform installer. Edit model inputs with deploy/deploy.sh configure.
PLATFORM_ADMIN_EMAIL=
PLATFORM_ADMIN_PASSWORD=
KEY_ENCRYPTION_KEY=
BETTER_AUTH_SECRET=
MANAGED_AGENT_TOKEN=
AGENT_TOOL_TOKEN=
COMPUTER_TOKEN=
SUPERVISOR_TOKEN=
SKILL_READER_DB_PASSWORD=
OPENBOT_AGENT_SOURCE=
BOT_IMAGE=openbot-platform-agent-bot:local
LANGGRAPH_IMAGE=openbot-platform-agent-langgraph:local
COMPUTER_IMAGE=openbot-platform-agent-computer:local
SUPERVISOR_IMAGE=openbot-platform-supervisor:local
IMAGE_PULL_POLICY=never
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
BOT_MODEL=
AGENT_BOT_MODEL=
OPENBOT_TOOL_URL=http://openbot-api:3001/api/agent-tools/call
MIGRATION_DATABASE_URL=postgresql://postgres:${POSTGRES_ADMIN_PASSWORD}@postgres:5432/openbot?sslmode=disable
OPIK_BASIC_AUTH=
OPENOBSERVE_COLLECTOR_EMAIL=collector@openbot.local
OPENOBSERVE_COLLECTOR_PASSWORD=
