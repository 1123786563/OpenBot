# Hindsight runtime configuration — copy to hindsight.env and fill every value.
#
# This file is the instance's explicit privacy declaration. #732: OpenBot no longer reads
# HINDSIGHT_PRIVACY_* (its compliance check left with the old memory engine), so these
# values are this instance's own facts.

# --- Authentication: service key + signed bank-scope assertion ------------------
# The service identity is a PAIR: the shared API key below proves the caller is this
# OpenBot deployment, and a short-lived HMAC-signed assertion (x-openbot-bank-scope,
# minted server-side by OpenBot per trusted identity) names whose banks the request may
# touch. Neither alone authorizes any memory operation (#381).
HINDSIGHT_API_TENANT_EXTENSION=openbot_tenant:OpenBotTenantExtension
HINDSIGHT_API_TENANT_API_KEY=change-me-hindsight-api-key
# MUST equal OpenBot's HINDSIGHT_BANK_ASSERTION_SECRET: this secret is what the
# extension verifies OpenBot's bank-scope assertions with.
HINDSIGHT_API_TENANT_ASSERTION_SECRET=change-me-bank-assertion-secret
# Confine every retain/recall/delete to the banks the assertion grants; tags are
# classification, never isolation.
HINDSIGHT_API_OPERATION_VALIDATOR_EXTENSION=openbot_tenant:OpenBotOperationValidator
# Surface the assertion header to the extensions (both HTTP and MCP transports).
HINDSIGHT_API_EXTENSION_PASSTHROUGH_HEADERS=x-openbot-bank-scope

# --- Approved model gateway -----------------------------------------------------
# LLM (extraction / reflect / consolidation). Provider `openai` = OpenAI-compatible
# endpoint. The base URL is the gateway's OpenAI-compatible root INCLUDING the /v1
# prefix (Hindsight's provider clients do not append it themselves), e.g.
# http://bifrost:8080/v1 for the approved Bifrost gateway.
#
# NOTE on the host address: Hindsight runs inside a container, where 127.0.0.1 is
# the CONTAINER itself, not this host. ONLY during isolated local verification
# (e.g. pointing at deploy/hindsight/test/gateway-standin.mjs on this host) may a
# gateway on the host be reached via http://host.docker.internal:9100/v1 — this
# address is for throwaway local verification against the stand-in and must NEVER
# be used in a real deployment. Use 127.0.0.1:9100/v1 only when running Hindsight
# directly on the host without a container, again for local verification only.
# A real deployment fills in the approved gateway URL (e.g. http://bifrost:8080/v1).
HINDSIGHT_API_LLM_PROVIDER=openai
HINDSIGHT_API_LLM_BASE_URL=change-me-gateway-base-url
HINDSIGHT_API_LLM_API_KEY=change-me-gateway-api-key
HINDSIGHT_API_LLM_MODEL=gpt-4o-mini

# Embeddings through the same approved gateway (note the provider segment in the
# variable names — HINDSIGHT_API_EMBEDDINGS_OPENAI_*). Same /v1-inclusive root and
# same rules as the LLM URL above: fill in the approved gateway URL; the
# host.docker.internal/127.0.0.1 addresses are for isolated local verification only.
HINDSIGHT_API_EMBEDDINGS_PROVIDER=openai
HINDSIGHT_API_EMBEDDINGS_OPENAI_BASE_URL=change-me-gateway-base-url
HINDSIGHT_API_EMBEDDINGS_OPENAI_API_KEY=change-me-gateway-api-key
HINDSIGHT_API_EMBEDDINGS_OPENAI_MODEL=text-embedding-3-small

# The reranker stays in-process (local provider, no network egress), so every model
# call that leaves the host goes through the gateway above.

# --- Privacy: retention & tracing (values are normative, do not relax) ----------
# Do not record LLM prompts/outputs (they contain employee memory content).
HINDSIGHT_API_LLM_TRACE_ENABLED=false
# Enable the bank LLM health probe endpoint so OpenBot's health check can tell
# "gateway reachable" from "service up" (it makes one minimal provider call per
# operation; returns status only).
HINDSIGHT_API_ENABLE_BANK_LLM_HEALTH=true
# Terminal operation rows keep their task payload; prune the whole row after 1 day.
HINDSIGHT_API_OPERATION_RETENTION_DAYS=1
HINDSIGHT_API_OPERATION_CLEANUP_INTERVAL_SECONDS=900

# --- Privacy declaration (this instance's own; OpenBot stopped mirroring it in #732) ---
# Keep them consistent with the runtime values above.
HINDSIGHT_PRIVACY_LLM_TRACE_ENABLED=false
HINDSIGHT_PRIVACY_OPERATION_RETENTION_DAYS=1
# Controlled backup retention enforced by backup.sh (delete older than N days).
HINDSIGHT_PRIVACY_BACKUP_RETENTION_DAYS=30
