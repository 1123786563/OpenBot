OPENBOT_DEPLOYMENT_ID=
OPENOBSERVE_OTLP_LOGS_URL=https://openobserve.persaas.cn/api/default/v1/logs
# The Collector uses an ingestion-only token for both stream headers.
# Encode `:` followed by the token with base64 and prefix it with `Basic `.
OPENOBSERVE_RUNTIME_AUTHORIZATION=
OPENOBSERVE_AUDIT_AUTHORIZATION=
OTEL_COLLECTOR_PORT=14318
# OPENBOT_RUNTIME_LOG_DIR=./runtime-logs
OPENBOT_DOCKER_LOG_GLOB=/docker-containers/*/*-json.log
