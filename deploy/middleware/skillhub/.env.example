SKILLHUB_WEB_PORT=18090
SKILLHUB_PUBLIC_BASE_URL=https://skillhub.persaas.cn
SKILLHUB_SESSION_COOKIE_SECURE=true

# Replace postgres with the database container's alias on the shared network.
SKILLHUB_POSTGRES_NETWORK=1panel-network
SKILLHUB_DATABASE_JDBC_URL=jdbc:postgresql://postgres:5432/skillhub
SKILLHUB_DATABASE_USER=skillhub
SKILLHUB_DATABASE_PASSWORD=

# Generate an independent secret with openssl rand -hex 32.
SKILLHUB_DOWNLOAD_ANON_COOKIE_SECRET=
SKILLHUB_BOOTSTRAP_ADMIN_ENABLED=true
SKILLHUB_BOOTSTRAP_ADMIN_PASSWORD=
SKILLHUB_BOOTSTRAP_ADMIN_EMAIL=admin@example.com
