# Copy to .env once; the three values marked GENERATE must never be the example ones.
#   openssl rand -hex 16; openssl rand -base64 32; openssl rand -hex 24
# Lose ENCRYPTION_KEY and every secret in the database is unreadable, backups included.
ENCRYPTION_KEY=GENERATE_WITH_openssl_rand_hex_16
AUTH_SECRET=GENERATE_WITH_openssl_rand_base64_32

POSTGRES_PASSWORD=GENERATE_WITH_openssl_rand_hex_24
POSTGRES_USER=infisical
POSTGRES_DB=infisical
DB_CONNECTION_URI=postgres://${POSTGRES_USER}:${POSTGRES_PASSWORD}@db:5432/${POSTGRES_DB}

REDIS_URL=redis://redis:6379
# The address the browser opens. Must match the published port in docker-compose.yml.
INFISICAL_PORT=18082
SITE_URL=http://localhost:18082

TELEMETRY_ENABLED=false
