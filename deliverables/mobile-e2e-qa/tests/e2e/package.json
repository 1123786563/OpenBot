{
  "name": "mobile-app-e2e",
  "version": "1.0.0",
  "private": true,
  "description": "E2E test suite: WebdriverIO + Appium (Android UiAutomator2 / iOS XCUITest)",
  "scripts": {
    "appium": "appium",
    "test:android": "wdio run tests/e2e/config/wdio.android.sim.conf.ts",
    "test:ios": "wdio run tests/e2e/config/wdio.ios.sim.conf.ts",
    "smoke:android": "APPIUM_PORT=4724 wdio run tests/e2e/config/wdio.android.env.conf.ts",
    "report": "allure generate ./allure-results --clean || npx allure generate ./allure-results --clean"
  },
  "dependencies": {
    "@wdio/allure-reporter": "^9.32.0",
    "@wdio/cli": "^9.32.0",
    "@wdio/globals": "^9.31.3",
    "@wdio/local-runner": "^9.32.0",
    "@wdio/mocha-framework": "^9.32.0",
    "@wdio/spec-reporter": "^9.32.0",
    "typescript": "^7.0.2",
    "webdriverio": "^9.32.0"
  },
  "devDependencies": {
    "appium": "^2.19.0"
  }
}
