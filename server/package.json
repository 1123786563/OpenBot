{
  "name": "server",
  "license": "MIT",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "build": "tsc --noEmit",
    "db:generate": "bun --env-file=../.env drizzle-kit generate --config=drizzle.config.ts",
    "db:migrate": "bun --env-file=../.env drizzle-kit migrate --config=drizzle.config.ts",
    "kb:db:generate": "bun --env-file=../.env drizzle-kit generate --config=drizzle-kb.config.ts",
    "kb:db:migrate": "bun --env-file=../.env src/kb/db/migrate.ts",
    "kb:dev": "bun --env-file=../.env --watch src/kb/index.ts",
    "kb:start": "bun --no-env-file src/kb/index.ts",
    "kb:worker": "bun --env-file=../.env src/kb/worker.ts",
    "kb:test": "bun test src/kb/",
    "kb:grpc-smoke": "bun --env-file=../.env scripts/kb/grpc-smoke.ts",
    "kb:t03-smoke": "bun --env-file=../.env scripts/kb/t03-smoke.ts",
    "kb:t05-smoke": "bun --env-file=../.env scripts/kb/t05-smoke.ts",
    "kb:contract-diff": "bun --env-file=../.env scripts/kb/contract-diff.ts",
    "fire:workshop-schedules": "bun --env-file=../.env scripts/fire-workshop-schedules.ts",
    "dev": "bun --env-file=../.env --watch src/index.ts",
    "start": "bun --no-env-file src/index.ts",
    "typecheck": "tsc --noEmit",
    "typecheck:enterprise": "tsc --noEmit -p tsconfig.enterprise-tests.json"
  },
  "dependencies": {
    "@ag-ui/client": "1.0.1",
    "@ag-ui/core": "1.0.1",
    "@ag-ui/mastra": "1.1.6",
    "@ai-sdk/openai": "3.0.99",
    "@aws-sdk/client-s3": "^3.1149.0",
    "@better-auth/drizzle-adapter": "^1.7.1",
    "@better-auth/electron": "1.7.1",
    "@better-auth/expo": "1.7.1",
    "@better-auth/scim": "1.7.1",
    "@better-auth/sso": "^1.7.1",
    "@composio/core": "^0.18.1",
    "@copilotkit/runtime": "1.77.0",
    "@grpc/grpc-js": "^1.14.0",
    "@grpc/proto-loader": "^0.8.1",
    "@mastra/client-js": "^1.43.0",
    "@mastra/core": "^1.64.0",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/api-logs": "0.221.0",
    "@opentelemetry/exporter-logs-otlp-http": "0.221.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.223.0",
    "@opentelemetry/resources": "^2.12.0",
    "@opentelemetry/sdk-logs": "0.221.0",
    "@opentelemetry/sdk-trace-node": "^2.12.0",
    "better-auth": "^1.7.1",
    "bullmq": "^6.3.12",
    "cel-js": "^0.8.2",
    "cron-parser": "^5",
    "docx": "^9.10.0",
    "drizzle-orm": "^0.45.2",
    "eventsource": "3.0.7",
    "hono": "^4.10.0",
    "ioredis": "^6.0.0",
    "marked": "^18.1.0",
    "p-limit": "^7.3.3",
    "pino": "^10.4.0",
    "postgres": "^3.4.9",
    "pptxgenjs": "^4.0.1",
    "rxjs": "7.8.1",
    "twilio": "5.13.0",
    "yaml": "^2.9.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@copilotkit/aimock": "1.43.0",
    "drizzle-kit": "^0.31.10",
    "pino-pretty": "^13.2.0"
  },
  "trustedDependencies": [
    "protobufjs"
  ]
}