{
  "name": "server",
  "license": "MIT",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "build": "tsc --noEmit",
    "db:generate": "bun --env-file=../.env drizzle-kit generate --config=drizzle.config.ts",
    "db:migrate": "bun --env-file=../.env drizzle-kit migrate --config=drizzle.config.ts",
    "dev": "bun --env-file=../.env --watch src/index.ts",
    "start": "bun --no-env-file src/index.ts",
    "typecheck": "tsc --noEmit",
    "typecheck:enterprise": "tsc --noEmit -p tsconfig.enterprise-tests.json"
  },
  "dependencies": {
    "@ag-ui/client": "1.0.1",
    "@ag-ui/core": "1.0.1",
    "@ag-ui/mastra": "1.1.6",
    "@ai-sdk/openai": "3.0.99",
    "@better-auth/drizzle-adapter": "^1.7.1",
    "@better-auth/electron": "1.7.1",
    "@better-auth/expo": "1.7.1",
    "@better-auth/scim": "1.7.1",
    "@better-auth/sso": "^1.7.1",
    "@composio/core": "^0.18.1",
    "@copilotkit/runtime": "1.77.0",
    "@mastra/client-js": "^1.43.0",
    "@mastra/core": "^1.64.0",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/api-logs": "0.221.0",
    "@opentelemetry/exporter-logs-otlp-http": "0.221.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.223.0",
    "@opentelemetry/resources": "^2.12.0",
    "@opentelemetry/sdk-logs": "0.221.0",
    "@opentelemetry/sdk-trace-node": "^2.12.0",
    "better-auth": "^1.7.1",
    "cel-js": "^0.8.2",
    "cron-parser": "^5",
    "drizzle-orm": "^0.45.2",
    "eventsource": "3.0.7",
    "hono": "^4.10.0",
    "ioredis": "^6.0.0",
    "pino": "^10.4.0",
    "postgres": "^3.4.9",
    "rxjs": "7.8.1",
    "twilio": "5.13.0",
    "yaml": "^2.9.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@copilotkit/aimock": "1.43.0",
    "drizzle-kit": "^0.31.10",
    "pino-pretty": "^13.2.0"
  }
}
