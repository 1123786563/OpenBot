# Copied from the OpenMuse repo root during the migration into OpenBot.
# Without these, pnpm resolves peer dependencies differently once this package
# stands alone outside the upstream workspace, and installs a different tree
# than upstream does.
auto-install-peers=false
strict-peer-dependencies=false

# This package now lives inside the OpenBot repo, whose root package.json pins
# `packageManager: bun@1.3.14`. pnpm walks up to find that manifest and then
# refuses to run ("This project is configured to use bun"), because this app is
# deliberately NOT part of that bun workspace. Both switches below keep pnpm
# usable inside this directory without touching the OpenBot root.
manage-package-manager-versions=false
package-manager-strict=false
